@0=~"Paquets en papier brun ! Matériel d'emballage ! Produits en papier ! Emballez vos affaires ici !"~
@3=~"Paquets en papier brun ! Matériel d'emballage ! Produits en papier ! Emballez vos affaires ici !"~
@5=~"Vous connaissez un gith du nom d'Ikss'odes ? Il paraît qu'il vit dans le coin."~
@7=~Le marchand désigne les bâtiments à droite du chronomètre."Le gith bizarre ? C'est ce bâtiment-là, mais ça fait un moment que j'l'ai pas vu. Demandez à sa copine, Mare."~
@9=~"Très bien, où puis-je la trouver ?"~
@12=~"Elle traîne généralement près de la Mer Verticale."~
@14=~"Où est-ce ?"~
@15=~"Merci. Je dois partir. Adieu."~
@17=~"Plus loin de l'eau, derrière la statue d'Athéna."~
@19=~"Merci. Je dois partir. Adieu."~
