@0=~L'homme contracte nerveusement ses muscles, prêt à attaquer à tout instant."T'as besoin d'un truc, bige ? Ou tu cherches juste une lame dans les reins ?"~
@2=~"Qui es-tu ?"~
@3=~"Quel est cet endroit ?"~
@4=~"Je cherche des informations."~
@5=~"Il est temps que je parte."~
@7=~Le voyou vous regarde droit dans les yeux."Moi ? J'suis un homme de Joseph le Noir. Qu'est-ce que ça peut t'faire ?"~
@9=~"Qui est Joseph le Noir ?"~
@10=~"Quel est cet endroit ?"~
@11=~"Je cherche des informations."~
@12=~"Il est temps que je parte."~
@14=~"Ce bouge ? Rivergate. Un sacré bon repaire."Il sourit de ses dents pourries.~
@16=~"Je cherche des informations."~
@17=~"Il est temps que je parte."~
@19=~"Écoute."La tension monte dans sa voix."J'suis pas un foutu indic. Va emmerder l'tavernier là-bas."Le voyou montre le comptoir.~
@21=~"Je vais faire ça."~
@22=~"Il est temps que je parte."~
@24=~L'homme relève fièrement la tête."C'est le meilleur cogneur d'crânes de cette partie d'la Ruche."Il montre la plate-forme."Le grand affranchi là-bas. Essaie donc de l'approcher."Il éclate de rire.~
@26=~"Quel est cet endroit ?"~
@27=~"Je cherche des informations."~
@28=~"Il est temps que je parte."~
@30=~"Ouais ? Alors dégage."~
