@0=~Les fiélons vous voient approcher avec Fury-Lies-Broken à vos côtés et bondissent de leurs positions nonchalantes.~
@1=~"Amnésique ! Tu es revenu, et tu as amené avec toi la compagne de Levistus !"s'écrie Tergush'tekhn. Il ne lui faut qu'une seconde pour l'examiner, remarquant sa silhouette émaciée et maladive, son bras manquant et ses yeux arrachés."Mais... elle a l'air abîmée."~ [g-05106]
@3=~"Tu m'as menti, Tergush'tekhn."~
@4=~"J'ai fait ce que tu demandais. Je veux ma récompense."~
@6=~Les fiélons vous regardent approcher, mais il est évident qu'ils cherchent quelqu'un d'autre dans votre groupe.~
@7=~"Amnésique... tu es revenu des Enfers ? Où est la maîtresse de Levistus ?"demande prudemment Tergush'tekhn.~ [g-05107]
@9=~"Tu m'as menti, Tergush'tekhn."~
@10=~"J'ai fait ce que tu demandais, elle n'est plus captive. Je veux ma récompense."~
@11=~"Elle est partie, Tergush'tekhn. Pour toujours."~
@13=~"Tu reviens quand même. De quoi as-tu besoin ?"~
@15=~"J'ai localisé le portail. Il se trouve dans la tour de l'horloge inondée, sur un îlot. Et *d'autres* diables sont encore venus me chercher au port..."~
@16=~"J'ai localisé le portail, mais je n'irai pas plus loin tant que tu n'auras pas augmenté la récompense. Cette mission est bien plus importante que je ne le pensais."~
@17=~"J'ai quelques questions."~
@19=~"Tu reviens quand même. De quoi as-tu besoin ?"~
@21=~"J'ai retrouvé et secouru Prod. Il est un peu moins compétent que je ne le pensais..."~
@22=~"J'ai quelques questions."~
@24=~"Tu reviens, amnésique. Tu as trouvé la clé ?"Tergush'tekhn hausse un sourcil écailleux.~
@26=~"J'ai rencontré cette femme sensat, et j'en sais maintenant beaucoup sur les portails itinérants, mais toujours pas ce qu'est réellement la clé."~
@27=~"J'ai parlé à cette femme sensat et beaucoup appris sur les portails itinérants, mais toujours pas ce qu'est réellement la clé."~
@28=~"J'ai quelques questions."~
@29=~"Je cherche encore."~
@31=~"Tu reviens quand même. De quoi as-tu besoin ?"~
@33=~"J'ai quelques questions."~
@34=~"Rien. Je vais poursuivre ma route."~
@36=~En vous voyant approcher, le baatezu tombe à genoux."Héros honoré, *JE T'EN PRIE*, écoute-moi."~
@37=~"Mon cher vieux camarade, qu'est-ce qui te prend ?"~
@39=~"J'écouterai ce que tu as à dire, fiélon."~
@40=~Ne rien dire, sourire simplement et partir.~
@42=~"Amnésique !"commence le baatezu."Arrête-toi et écoute un instant, pour l'amour d'Asmodée !"~ [g-05102]
@44=~"J'écouterai ce que tu as à dire, fiélon."~
@45=~"Asmodée ? Je ne peux pas dire que cela m'émeuve. Adieu."~
@46=~"Désolé, mais me croirais-tu si je te disais que je suis encore entré ici par accident ?"~
@48=~Dans l'arrière-salle du Bar du Cadavre Fumant, à côté de deux abishaïs familiers, se tient un troisième aux écailles d'un rouge sombre. Il est plus grisonnant et voûté, mais son regard indique clairement qu'il ne faut pas confondre son état avec de la faiblesse.~
@49=~"Tu es venu..."grogne-t-il."Je commençais à croire que tu n'étais finalement pas taillé pour ça, amnésique."~ [g-05101]
@50=~"Je t'avais dit qu'il viendrait, Tergush'tekhn ! La parole d'un matois vaut quelque chose... quand il se souvient de qui est qui."~
@51=~"Il aurait pu venir *un peu* plus tôt..."~
@53=~"Je suis venu dès que j'ai été prévenu."~
@54=~"J'étais... censé venir ?"~
@55=~"Je viens quand bon me semble, fiélon."~
@56=~"Désolé, ça ne m'intéresse pas. Je suis entré ici par accident."~
@58=~L'abishaï grisonnant vous scrute de ses petits yeux."Tu reviens, amnésique. Changé d'avis dans ta boîte à cervelle ? Prêt à conclure un marché avec un diable, finalement ?"~
@60=~"J'écouterai ce que tu as à dire, fiélon."~
@61=~"J'y ai réfléchi, et j'écouterai ce que tu as à dire, fiélon."~
@62=~"J'allais écouter... mais"un marché avec un diable", ça ne donne pas très envie. Je vais poursuivre ma route."~
@63=~"Désolé, ça ne m'intéresse toujours pas. D'une manière ou d'une autre, je suis ENCORE entré ici *par accident*."~
@65=~L'abishaï se relève de ses genoux épineux."Tu as retrouvé la raison. Nous avons des choses importantes à discuter et un travail qui te rendra très riche."~
@67=~"De quoi parlons-nous exactement ?"~
@68=~"Les promesses des diables valent rarement grand-chose..."~
@69=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@71=~"Ça suffit ! Tu as franchi le Styx, péquin !"Les yeux de l'abishaï brûlent de fureur. Quelque chose vous dit que vous venez de passer à côté de toute l'aventure.~ [g-05108]
@73=~"D'accord..."~
@75=~L'abishaï rouge ravale sa colère et poursuit."Ce n'est pas un marché. C'est une mission."Il soupire."Nous te verserons une prime pour prouver notre bonne..."Il crache, et sa salive grésille sur le sol de l'arrière-salle."...volonté."~
@77=~"Très bien, alors de quoi parlons-nous ?"~
@79=~Tergush'tekhn réfléchit."Je pensais la même chose. D'habitude, elle tue tout ce qui se trouve devant elle, alors ça a dû être un coup de surin dans le dos. Cania est réputée pour ses traîtrises ; c'est donc une explication plausible."~
@81=~"Pourquoi ne pouvez-vous pas y aller ?"~
@82=~"J'ai d'autres questions."~
@84=~Tergush'tekhn affiche un sourire mauvais."Demande, amnésique."~
@86=~"Qui étaient les deux abishaïs rouges qui te traquaient au port ?"~
@87=~"Si Fury est une guerrière si redoutable, comment a-t-elle pu être capturée ?"~
@88=~"Quelle était la mission de Fury ?"~
@89=~"Qu'est-ce que Méphistar ?"~
@90=~"Tu as parlé de Méphistar, la demeure de Méphistophélès."~
@91=~"Tu as parlé de Méphistar, ancienne demeure de Méphistophélès, prise par Molikroth."~
@92=~"Tout cela me fait penser qu'il me faut des informations plus précises sur Cania pour mieux me préparer."~
@93=~"Tu en sais davantage sur cette professeure ?"~
@94=~"Je suis moi aussi sensat. Je crois avoir entendu parler d'une spécialiste des portails de passage. Mawu, c'est ça ?"~
@95=~"Rappelle-moi comment une guerrière aussi redoutable a pu être capturée."~
@96=~"Rappelle-moi qui est Fury."~
@97=~"Toujours pas prêt à me parler de sa mission ?"~
@98=~"Reparle-moi de ce... Méphistar."~
@99=~"Reparle-moi de Méphistar."~
@100=~"Rappelle-moi ce que tu sais de Mawu."~
@101=~"On peut reparler de la recherche du portail ?"~
@102=~"Dis-moi, combien suis-je payé ?"~
@103=~"Rappelle-moi, combien suis-je payé ?"~
@104=~"Je ne peux m'empêcher de remarquer que ma... charmante nouvelle compagnie ne te dérange plus."~
@105=~"Je veux en savoir plus sur toi. Je ne t'avais encore jamais vu."~
@106=~"Je crois que c'est tout ce que j'avais besoin de savoir. Je m'en vais."~
@108=~Les fiélons échangent des regards inquiets, comme si aucun d'eux ne voulait exprimer ce qu'ils pensent tous. Finalement, Tergush'tekhn fixe Aethelgrin, qui cède et entrouvre lentement son museau garni de dents.~
@109=~"Nous ne pouvons pas, vieux camarade. C'est compliqué."~
@110=~"C'est une affaire de hiérarchie infernale. Tu n'en fais pas partie, donc tu en es exempté."~
@112=~"Je comprends assez bien la hiérarchie infernale. J'aimerais savoir ce qui se passe."~
@113=~"Très bien, j'ai d'autres questions."~
@115=~Les fiélons se regardent à nouveau. La tension monte visiblement."Eh bien, nous sommes liés à un certain Seigneur des Neuf, et il se pourrait que nous ne soyons pas très bienvenus dans ce coin précis du multivers en ce moment..."~
@116=~"Ooooh chef. Je n'aime *PAS DU TOUT* ce que j'entends."~
@117=~"Ce n'est pas comme si nous étions en guerre, ni rien d'aussi grave... mais nous devons garder nos distances, juste au cas où."~
@119=~"Qu'y a-t-il, Morte ?"~
@120=~"Très bien, j'ai d'autres questions."~
@122=~Tergush'tekhn fusille le crâne du regard."Tu devrais choisir tes prochains mots avec soin, crâne."~
@123=~"Chef, c'est une chose de se retrouver entre les baatezus et les tanar'ris, mais... fourrer ton nez dans les affaires des Seigneurs, c'est comme... fourrer ton nez entre les fesses d'un bariaure."~
@124=~"Comme si tu connaissais *QUOI QUE CE SOIT* aux nez. Tu ne sais probablement même pas à quel point tu pues les Enfers."~
@126=~"Je crois que nous allons devoir augmenter ma récompense."~
@127=~"J'ai d'autres questions."~
@129=~Le diable rouge soupire."Très bien... mais tu te souviens que tu as un intérêt personnel dans cette affaire, n'est-ce pas ?"~
@130=~"Le personnel, ça paie pas les couteaux ni les potions, sacs d'écailles."~
@132=~"J'ai d'autres questions."~
@134=~"Il faut que je te le rappelle ? Évidemment, tu ne t'en souviendrais pas."Tergush'tekhn regarde ses compagnons fiélons et rit d'un gloussement rauque."Fury est la créature la plus époustouflante que tu aies jamais vue. Rien que cela suffira à te permettre de la reconnaître."~
@135=~"Raconte !"~
@137=~"Très bien, j'ai d'autres questions."~
@139=~Tergush'tekhn se fige."Sa mission ? Ce ne sont pas tes affaires, voilà tout."~
@140=~"Désolé, vieux camarade, cette information est strictement réservée aux oreilles diaboliques."~
@142=~"Très bien, j'ai d'autres questions."~
@144=~Les trois fiélons vous dévisagent en silence.~
@146=~"Très bien, j'ai d'autres questions."~
@148=~"Une énorme masse maniérée et paresseuse qui s'est lentement hissée au pouvoir à la cour de Méphistar. Il a intrigué et accru son influence jusqu'à réussir un coup d'État contre Méphistophélès."~
@149=~"Il adore la torture et on le soupçonne d'avoir été placé là par Asmodée lui-même, qui..."~
@150=~Tergush'tekhn saisit le museau de Tegar'in de ses griffes."Ne bavarde pas autant !"~
@152=~"Ça pourrait être très important, dis-m'en plus."~
@153=~"Tu as parlé d'un... Ordre du Serpent ?"~
@154=~"Tu avais encore quelque chose à dire sur l'influence persistante de Méphistophélès ?"~
@155=~"Très bien, j'ai d'autres questions."~
@157=~"Méphistar est la plus grande bourgade, et pratiquement la seule de toute cette maudite strate. Elle a été bâtie autour de la tour arcanique de Méphistophélès..."~
@158=~"Mais depuis le coup d'État, la cité est dirigée par le baron Molikroth et son conseil. On dit que Méphistophélès a disparu."~
@159=~"Son influence demeure. Certains membres de son Ordre Serpentin sont toujours présents et tentent de faire ce qu'ils ont toujours fait..."Il s'interrompt brusquement.~
@161=~"Parle-moi de ce baron."~
@162=~"L'Ordre Serpentin ?"~
@163=~"Tu avais encore quelque chose à dire ?"~
@164=~"Très bien, j'ai d'autres questions."~
@166=~Tergush'tekhn vous regarde droit dans les yeux."Méphistophélès a toujours voulu être le numéro un. Mais *ça*, c'est Asmodée, et ce le sera toujours. Sur le papier, Molikroth ne possède *AUCUN* des talents arcaniques de Méphistophélès. Il a forcément reçu de l'aide."~
@168=~"Tu as parlé d'un... Ordre Serpentin ?"~
@169=~"Tu avais encore quelque chose à dire sur l'influence persistante de Méphistophélès ?"~
@170=~"Très bien, j'ai d'autres questions."~
@172=~"Ah oui. La mystérieuse légion de Méphistar, sous le commandement direct d'un certain seigneur Corin, mais loyale à Méphistophélès. Même aujourd'hui."~
@173=~"Ils sont spécialisés dans les coups de cape et de poignard contre les..."Il se tourne et crache."Tanar'ris."~
@174=~"Je doute que le baron apprécie beaucoup leur présence..."~
@176=~"Parle-moi de ce baron."~
@177=~"Tu avais encore quelque chose à dire sur l'influence persistante de Méphistophélès ?"~
@178=~"Très bien, j'ai d'autres questions."~
@180=~"Il y a à sa cour une alu-fiélonne appelée Antilia qui s'oppose ouvertement au baron, et il ignore inexplicablement ses manigances venimeuses."~
@181=~"Nous n'en connaissons pas le fin mot."~
@183=~"Parle-moi davantage de ce baron."~
@184=~"Tu as parlé d'un... Ordre Serpentin ?"~
@185=~"Très bien, j'ai d'autres questions."~
@188=~Les fiélons semblent impressionnés par vos connaissances."Mais oui. Méphistar est la plus grande bourgade, et pratiquement la seule de toute cette maudite strate. Elle a été bâtie autour de la tour arcanique de Méphistophélès..."~
@189=~"Mais depuis le coup d'État, la cité est dirigée par le baron Molikroth et son conseil. On dit que Méphistophélès a disparu."~
@190=~"Son influence demeure. Certains membres de son Ordre Serpentin sont toujours présents et tentent de faire ce qu'ils ont toujours fait..."Il s'interrompt brusquement.~
@192=~"Parle-moi de ce baron."~
@193=~"L'Ordre Serpentin ?"~
@194=~"Tu avais encore quelque chose à dire ?"~
@195=~"Très bien, j'ai d'autres questions."~
@197=~"Des informations plus précises ?"Tergush'tekhn soupire."Il y fait froid, un froid à rendre fou, mais nous te donnerons quelque chose pour y résister. Il peut y avoir quelques dangers dans les étendues sauvages : gélugons, glace animée, parfois un géant du givre... rien dont *toi* tu aies à t'inquiéter. C'est une strate très montagneuse, alors j'espère que tu n'as pas le vertige."~
@198=~"*N'ESSAIE PAS* d'atteindre Nessus ! Cela pourrait être tentant, puisque Cania en détient la seule entrée et que la plupart des créatures du multivers ignorent à quoi ressemble Nessus, mais... *tous* tes amis mourraient, et toi tu pourrais passer ton immortalité dans une chambre de torture."~
@200=~"Très bien... Je m'en souviendrai. J'ai d'autres questions."~
@202=~"Oh, je n'en sais pas beaucoup. Elle s'appelle Mawu. Elle a parcouru les plans et elle sait des choses. J'aurais soutiré ces informations d'elle en un clin d'œil, mais..."~
@203=~"Ce n'est vraiment *PAS* ma fau..."~
@204=~L'abishaï rouge l'interrompt."Elle ne devrait vraiment pas poser de problème."~
@206=~"J'ai d'autres questions."~
@208=~"Oui, elle s'appelle Mawu. Elle a parcouru les plans et elle sait des choses. J'aurais soutiré ces informations d'elle en un clin d'œil, mais..."~
@209=~"Ce n'est vraiment *PAS* ma fau--"~
@210=~Tergush'tekhn l'interrompt."Elle ne devrait vraiment pas poser de problème."~
@212=~"J'ai d'autres questions."~
@214=~"Nous avons amassé une belle quantité de jonc. Trois mille Möbius te conviendraient-ils ?"~
@215=~"Möbi... ouais. Ouais !"~
@216=~"Des pièces de Möbius... c'est très généreux."~
@217=~"Je *connais* ces pièces... les marchands les utilisent généralement pour les transactions en gros."~
@218=~"Des Möbius ! Oui, s'il vous plaît !"~
@220=~"Cela tient compte des primes dont nous étions convenus ?"~
@221=~"Cela tient compte des primes dont nous étions convenus ?"~
@222=~"Cela tient compte des primes dont nous étions convenus ?"~
@223=~"Cela tient compte des primes dont nous étions convenus ?"~
@224=~"Cela tient compte des primes dont nous étions convenus ?"~
@225=~"Cela tient compte des primes dont nous étions convenus ?"~
@226=~"Cela tient compte des primes dont nous étions convenus ?"~
@227=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@229=~"Ah, oui. Cela fait 3 200 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@231=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@233=~"Ah, oui. Cela fait 3 400 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@235=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@237=~"Ah, oui. Cela fait 3 600 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@239=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@241=~"Ah, oui. Cela fait 3 800 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@243=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@245=~"Ah, oui. Cela fait 4 000 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@247=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@249=~"Ah, oui. Cela fait 5 000 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@251=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@253=~"Ah, oui. Cela fait 6 000 Möbius au total."Tergush'tekhn semble déçu que vous vous en souveniez.~
@255=~"Cela me paraît satisfaisant. J'ai d'autres questions."~
@257=~Les trois fiélons tournent leur attention vers le membre tanar'ri de votre groupe. Finalement, Tergush'tekhn déclare :"Tu seras débarrassé de cette vermine assez vite dans les profondeurs de Baator, camarade."~
@259=~"Je n'aime pas beaucoup entendre ça."~
@261=~"C'est simplement un fait."~
@262=~"Les profondeurs des Enfers, c'est rien à côté de la profondeur de *merde* dans laquelle j'étais quand les Têtes-de-mort ratissaient la Ruche à la recherche des escrocs."~
@263=~"J'ai moi-même été à Baator, et je suis aujourd'hui plus fort que jamais."~
@265=~"J'ai d'autres questions."~
@267=~"Et elle ne savait pas exactement où celui-ci apparaît ? C'est dommage..."Tergush'tekhn semble un peu déçu."Que faisons-nous pour la clé, alors ?"~
@269=~"J'ai peut-être une piste pour la clé. Je dois retrouver quelqu'un. Quant au portail... vous avez dit que quelqu'un travaillait dessus dans le Fossé ?"~
@270=~"Je vais essayer de trouver la réponse. Quant au portail... vous avez dit que quelqu'un travaillait dessus dans le Fossé ?"~
@272=~"Le Fossé, en effet. Les habitants donnent ce nom à toute la zone autour du Fossé proprement dit. Tu devrais chercher notre agent..."Il s'arrête et soupire."Un diablotin appelé Prod. Il a peut-être déjà trouvé quelque chose."Sa voix trahit une pointe d'incertitude.~
@273=~"Il maintient un équilibre délicat entre idiotie et utilité ; sois prudent."~
@274=~"Il devrait y avoir dehors un petit mortel qui se prépare à conduire des gens en excursion dans le Fossé. Ils ont créé une sorte d'attrape-touristes, avec les gars du gang travaillant pour un chef local."~
@275=~"Mais ne pars pas pour Cania sans nous revoir d'abord ! Premièrement, nous avons des informations supplémentaires dont tu n'as pas encore à te soucier. Deuxièmement, nous devons te fournir la protection que nous avons promise."~
@277=~"Un attrape-touristes ? Ingénieux. Je vais essayer de trouver ce gamin. Et le diablotin. Adieu."~
@279=~"Prod ! Mauvais diablotin ! Tu t'étais perdu ?"~ [g-05104]
@280=~"Non ! Monsieur ! Non... Prod a été RETROUVÉ !"~ [g-00603]
@282=~"Prod m'a raconté deux ou trois choses sur le fait que Fury serait... la compagne de Levistus ?"~
@284=~"Eh bien... Ce n'est pas... pas faux... Quelle importance ?"~
@286=~"Tu aurais pu me le dire, c'est tout. Nous devrions y aller, nous avons un portail à trouver."~
@287=~"C'est une affaire qui implique DIRECTEMENT les Seigneurs des Enfers. Et si vous augmentiez la récompense... beaucoup ? Sinon, je parlerai."~
@289=~Les diables se regardent, dissimulant à peine leur colère, mais votre raisonnement semble les convaincre."Très bien, vieux camarade... davantage de Möbius pour toi..."~
@291=~"Parfait, j'ai d'autres questions."~
@293=~Les diables se regardent, puis se tournent vers vous."Tu négocies *durement*, toi..."~
@294=~"...as raison. C'est une sacrée mission, vieux camarade. Mais nous ne pouvons rien offrir de plus, désolé."~
@296=~"Ça me va. Je vais descendre dans l'avant-dernière strate des Enfers pour sauver l'amante disparue d'un Seigneur usurpateur détesté de tous les autres. Cela va certainement très bien se passer."~
@298=~"Très bien ! Oh, Asmodée, aide-moi, toute notre prime y passe..."~
@299=~"Chef... Peut-être qu'on devrait reconsidérer la question. Dit comme ça en une seule phrase... j'ai vraiment pas envie d'y aller."~
@301=~"Vous ne le regretterez pas. Je suis un homme de parole."~
@303=~"Excellente nouvelle, Sans-Nom. Quant aux diables... eh bien, tu sais comment sont les baatezus. Quoi qu'ils aient voulu, ils ne te suivront certainement pas jusqu'à Cania."Tergush'tekhn vous tapote l'épaule d'un geste rassurant.~
@304=~"Et la clé ?"~
@306=~"J'y travaille... Je devrais aller continuer d'y travailler, tout de suite."~
@307=~"Je l'ai aussi. Ça a été toute une *autre* épreuve..."~
@308=~"J'ai d'abord quelques questions."~
@310=~"Alors qu'est-ce que tu fais encore ici ? Tu as la clé, tu as le portail, vas-y !"~ [g-05105]
@311=~"Ramène notre camarade. Elle mérite sa liberté."~
@312=~"Écoute bien... Tout d'abord, emmène Prod avec toi. À Méphistar, il y a des bains appelés les Larmes d'Inanna, qui abritent un portail secret vers la ville-portail d'Échine. Prod sait l'ouvrir. Garde-le simplement en vie : c'est ton billet de retour ici."~
@313=~"Oui, oui. Garder en vie. Prod est un diablotin important !"~ [g-00607]
@314=~"Ton contact à Cania sera un abishaï blanc nommé Gemariel."~ [g-05109]
@315=~"Pas tout à fait des nôtres... mais suffisamment."~
@316=~"C'est... un étranger, mais il s'est montré digne de confiance lors de contrats précédents. Il devrait t'attendre sur place."~ [g-05111]
@317=~"Troisièmement..."Le diable ouvre un grand sac posé au sol et en sort une robe écarlate."Cette robe te protégera, ainsi que tes éventuels compagnons, du climat de Cania. Elle prélèvera peut-être une goutte de ton sang, mais c'est normal."~
@319=~"Elle n'a pas besoin de l'être. Sa magie suffit."~
@321=~L'abishaï rouge semble un peu surpris par les questions."Moi ? Je suis Tergush'tekhn. Un abishaï rouge."Il vous observe avec une pointe de provocation.~
@323=~"Ta couleur... tu es supérieur à tes deux amis. Comment se fait-il que tu fréquentes de tels compagnons ?"~
@324=~"Très bien, j'ai d'autres questions."~
@326=~Tergush'tekhn paraît agacé par la question."Nous venons tous du même endroit. Nous partageons des objectifs communs... des ennemis communs... Il n'y a rien d'étrange à cela."~
@328=~Bluffer :"Ah oui. Vous venez tous d'Échine..."~
@329=~"Très bien, j'ai d'autres questions."~
@331=~"Nous..."~
@332=~"Non, camarade, c'est Jangling Hiter."~
@333=~Tergush'tekhn fronce les sourcils en regardant son ami."Ce n'est pas le genre de chose que nous racontons à n'importe qui."~
@334=~"D'accord..."~
@336=~"Très bien, j'ai d'autres questions."~
@338=~"Ce passage n'est pas encore écrit - ACTE 3"~
@341=~"Ce passage n'est pas encore écrit - ACTE 3"~
@344=~"Ce passage n'est pas encore écrit - ACTE 3"~
@347=~"Ce passage n'est pas encore écrit - ACTE 3"~
@350=~L'abishaï s'approche légèrement de vous, irradiant une aura de chaleur. Il baisse la voix :"Nous avons une mission pour toi, amnésique. Une mission qui pourrait t'être très profitable."~
@352=~"Mais j'ai presque résolu l'énigme de mon existence. J'en suis aux toutes dernières étapes. Je ne suis revenu à Sigil que pour un bref instant avant d'affronter mon destin."~
@354=~"Ouuui. Comme tu l'as déjà fait, et pourtant te revoilà. N'as-tu pas trouvé des preuves que tu fais cela encore et encore ? Ne préférerais-tu pas, pour une fois, tenter quelque chose qui puisse réellement fonctionner ?"~
@356=~"J'ai le sentiment que cette fois est différente. Peut-être ai-je une dernière chance de réussir cette fois-ci."~
@358=~Le diable aux écailles rouges rit doucement et murmure :"Tu as bien plus raison que tu ne le crois, mais en même temps tellement tort."~
@359=~"Il est vrai que tu as détruit certaines des pierres qui t'ont conduit jusqu'à cet instant, mais, sans le vouloir, tu en as créé de nouvelles. Tu ne peux pas encore le voir, mais dans quelques années tu te retrouveras probablement ici, dans ce bar, à poser encore et encore des questions sur ces tatouages. Mais sur un point tu as raison : cette fois *est* différente, uniquement à cause de ce que je m'apprête à te révéler."~
@361=~"Ah vraiment ? Qu'est-ce que c'est, alors ?"~
@363=~L'abishaï s'approche encore davantage."Commençons par le fait que nous nous connaissons déjà. Comme mes collègues aux écailles sombres, j'ai combattu à tes côtés il y a très longtemps. Une autre... femme combattait avec nous, et elle était *très* proche de toi."~
@364=~"Si elle était jolie, ça me paraît très plausible, chef."~
@365=~"Je ne suis pas venu les mains vides. Je sais que tes souvenirs ont une drôle de façon de te revenir, même par fragments. J'ai apporté quelque chose qui lui appartenait pour voir si cela déclenche quoi que ce soit en toi."Tegar'in présente un casque rouge à cornes, d'une facture exquise et apparemment très ancien."Elle le portait la dernière fois que vous vous êtes vus, je crois. Vas-y, touche-le et vois si quelque chose te revient."~
@367=~Prendre le casque entre vos mains.~
@369=~Le souvenir vous frappe comme un bariaure lancé au galop. *Bien sûr* que vous la connaissez. Elle était votre monde, votre ancre, il y a une éternité, lorsque vous étiez encore... mortel. Vous ne parvenez pas à vous rappeler le sujet de vos conversations, mais vous vous souvenez de la profondeur de votre confiance et de votre complicité. Elle vous connaît mieux que vous ne pourriez jamais vous connaître vous-même. Elle pourrait mettre fin à votre tourment. Définitivement. Comment avez-vous pu l'oublier ?~ [SPTR_01]
@370=~"Je crois que ça a marché, patron. Le matois fixe le vide comme s'il avait oublié qu'il existait", dit le fiélon en ramassant rapidement le casque pour le remettre dans un sac posé au sol.~
@371=~"Tu l'as vue, n'est-ce pas ? Elle s'appelle Fury-Vehement. C'est la créature la plus belle et la plus meurtrière dont le sang ait jamais souillé les champs de bataille d'Averne et de Khalas. Malheureusement, Fury a besoin de notre aide. Elle a disparu, sa piste s'est refroidie et il est impossible de la contacter... mais nous savons qu'elle est vivante."~
@372=~"Si elle avait été détruite, son supérieur le saurait."~
@373=~"Nous voulons que tu partes à son secours. Outre le fait d'aider une vieille amie, cela pourrait te rapporter d'importantes récompenses, financières et, surtout, personnelles."~
@375=~"Où a-t-elle été vue pour la dernière fois ?"~
@376=~"Parle-moi des avantages financiers."~
@377=~"Donc nous nous connaissons ? Peut-elle vraiment m'aider ?"~
@378=~"Qui est son supérieur ?"~
@379=~"Pourquoi moi ?"~
@381=~L'abishaï rouge soupire, comme accablé par ce qu'il doit vous dire. Il se ressaisit et murmure :"À Méphistar, sur la huitième strate de Baator : Cania."~
@383=~"Comment pourrais-je m'y rendre ?"~
@384=~"C'est... vraiment très profond dans les Enfers."~
@385=~"Parle-moi des avantages financiers."~
@386=~"Donc nous nous connaissons ? Fury peut-elle vraiment m'aider ?"~
@387=~"Qui est son supérieur ?"~
@388=~"Pourquoi moi ?"~
@389=~"Baator ? Désolé, finalement ça ne m'intéresse vraiment pas."~
@391=~"Ah, oui", acquiesce le baatezu."Tu connais les strates des Enfers. C'est un endroit froid et impitoyable pour les mortels, une terre de trahison et de désespoir. En vérité, il s'agit surtout d'une étendue glacée. Nous t'aiderons toutefois à supporter les... pires aspects de cet environnement."~
@392=~"Nous avons une robe très utile qui peut t'aider à... ne pas geler. Son aura s'étend aussi à plusieurs personnes."~
@394=~"Comment pourrais-je m'y rendre ?"~
@395=~"Parle-moi des avantages financiers."~
@396=~"Donc nous nous connaissons ? Fury peut-elle vraiment m'aider ?"~
@397=~"Qui est le supérieur de Fury ?"~
@398=~"Pourquoi moi ?"~
@399=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@401=~Tergush'tekhn sourit sinistrement."Nous savons certaines choses sur toi, Sans-Nom... mais relativement peu. Et toi-même, tu sais très peu de choses sur toi. Tu crois peut-être en avoir beaucoup appris ces derniers jours, mais ce n'est que la partie émergée de l'iceberg. Aucun de nous n'a jamais passé autant de temps seul avec toi que Fury. Il y a des siècles, elle s'est vantée devant nous que tu lui avais confié tes secrets les plus profonds. Elle, elle ne souffre pas d'amnésie ; elle pourrait donc probablement te révéler quelques détails intéressants et certainement te proposer des alternatives à la voie autodestructrice que tu suis actuellement."~
@403=~"Où Fury a-t-elle été vue pour la dernière fois ?"~
@404=~"Comment pourrais-je me rendre à Cania ?"~
@405=~"Parle-moi des avantages financiers."~
@406=~"Qui est le supérieur de Fury ?"~
@407=~"Pourquoi moi ?"~
@408=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@410=~"Nous avons amassé une belle quantité de jonc. Trois mille Möbius te conviendraient-ils ?"~
@411=~"Möbi... Ouais. Ouais !"~
@412=~"Des pièces de Möbius... c'est très généreux."~
@413=~"Je *connais* ces pièces... les marchands les utilisent généralement pour les transactions en gros."~
@414=~"Des Möbius ! Oui, s'il vous plaît !"~
@416=~"Où Fury a-t-elle été vue pour la dernière fois ?"~
@417=~"Très bien, et ensuite ? Comment pourrais-je me rendre à Cania ?"~
@418=~"Donc nous nous connaissons ? Fury peut-elle vraiment m'aider ?"~
@419=~"Qui est son supérieur ?"~
@420=~"Pourquoi moi ?"~
@421=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@423=~"Tu n'as pas à t'en soucier. Ce ne sont que des affaires politiques entre baatezus. Ce qui compte, c'est que nous sachions qu'elle respire encore."~
@425=~"Où Fury a-t-elle été vue pour la dernière fois ?"~
@426=~"Très bien, et ensuite ? Comment pourrais-je me rendre à Cania ?"~
@427=~"Parle-moi des avantages financiers."~
@428=~"Donc nous nous connaissons ? Fury peut-elle vraiment m'aider ?"~
@430=~"Pourquoi moi ?"~
@432=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@434=~Les diables échangent des regards entendus."Nous avons vu ce dont tu es capable. Nous savons que tu es digne de confiance. Tu seras la bonne personne au bon endroit, je n'en doute pas. Et après tout... Fury était ta plus proche confidente."~
@436=~"Où Fury a-t-elle été vue pour la dernière fois ?"~
@437=~"Très bien, et ensuite ? Comment pourrais-je me rendre à Cania ?"~
@438=~"Parle-moi des avantages financiers."~
@439=~"Donc nous nous connaissons ? Fury peut-elle vraiment m'aider ?"~
@440=~"Qui est son supérieur ?"~
@441=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@443=~"Une minute."Le fiélon découvre ses crocs dans un simulacre de sourire."Avant de te révéler la suite... tu dois déclarer que tu es des nôtres... de manière contraignante."Un contrat se matérialise entre ses griffes.~ [g-05103]
@445=~"Bien sûr. Où est-ce que je signe ?"~
@446=~"Oh... très bien. Où est-ce que je signe ?"~
@447=~"Je peux d'abord le lire ?"~
@448=~"Pourquoi faut-il mettre cela par écrit ?"~
@449=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@451=~Les fiélons éclatent d'un même rire."Oh, amnésique méfiant. Tu nous soupçonnes vraiment de convoiter ton *âme* ? Quelle plaisanterie. Néanmoins... *bien sûr* que tu peux le lire."Tergush'tekhn vous tend le document."Après tout, le diable se cache dans les détails, n'est-ce pas ?"~
@452=~Le contrat ne mentionne l'âme de personne. Il s'agit d'une transaction simple : de l'argent en échange du retour de Fury au Bar du Cadavre Fumant. Toutes les parties doivent faire preuve de discrétion et ne révéler ni le but ni la destination du voyage. Les fiélons sont également tenus de fournir un artefact permettant de survivre à Cania. Vous êtes tenu d'atteindre Cania selon les instructions des diables.~
@453=~"Ça me paraît correct. Je ne vois aucun piège caché."~
@454=~"Analyse terminée. Légalité du document estimée à 97,3 %."~
@456=~"Bien sûr. Où est-ce que je signe ?"~
@457=~"Oh... très bien. Où est-ce que je signe ?"~
@460=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@462=~"Que dirais-tu si, une fois la mission accomplie, nous prétendions ne pas te connaître ?"~
@463=~"Pas que nous ferions une chose pareille..."intervient aussitôt le second baatezu."Mais un contrat est toujours nécessaire !"~
@464=~"Le jonc est indispensable. S'il faut un contrat, signe-le."~
@467=~"Bien sûr. Où est-ce que je signe ?"~
@468=~"Oh... très bien. Où est-ce que je signe ?"~
@470=~"Je peux d'abord le lire ?"~
@471=~"Désolé, finalement ça ne m'intéresse vraiment pas."~
@473=~Le document accepte votre signature et confirme son caractère définitif dans un éclair orange. Les fiélons se détendent visiblement.~
@474=~Tergush'tekhn découvre ses dents dans un sourire."Excellent. Il y a de l'espoir pour le retour de notre amie. Nous pouvons passer à la suite."~
@476=~"Je demandais comment me rendre à Cania."~
@478=~"Près de Méphistar se dresse une haute montagne aux deux sommets : Nemezia. Récemment, le cadavre nu et gelé d'un homme est apparu à son sommet. De courageux baatezus l'ont identifié grâce à son tatouage : il s'agissait de Manohae Brine, de la Société des Sensations, un Sigilien. Près de son corps se trouve une vieille arche de pierre que les arcanistes convoqués ont déterminé être la sortie d'un portail itinérant."~
@479=~"Après une brève enquête, il s'est avéré que Manohae était... un requin-garou, ce qui explique probablement pourquoi personne n'avait encore découvert ce portail à Sigil. Il se trouve sans doute sous l'eau, très probablement dans le Fossé ou à proximité. L'arche est toujours debout, mais si les autorités locales la découvrent, elles la détruiront probablement."~
@480=~"Un requin-garou ? Donc comme un rat-garou, mais requin ? C'est génial !"~
@482=~"Tu as parlé de Nemezia ?"~
@483=~"Qu'est-ce que le Fossé ?"~
@484=~"Alors, qui a découvert le portail ?"~
@485=~"Pourquoi les autorités locales voudraient-elles détruire cette arche à Cania ?"~
@486=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@488=~"C'est le nom de la montagne..."Le baatezu semble déconcerté par votre question."Elle est assez proche de Méphistar et offre une vue spectaculaire. Elle est haute, rocheuse... Je ne sais pas quoi ajouter, amnésique."~
@490=~"Qu'est-ce que le Fossé ?"~
@491=~"Alors, qui a découvert le portail ?"~
@492=~"Pourquoi les autorités locales voudraient-elles détruire cette arche ?"~
@493=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@495=~"C'est une rivière locale qui coule entre le quartier de la Ruche et le Bas-Quartier."~
@496=~"Une rivière ?"Annah renifle avec mépris."C'est bien la première fois que j'entends une connerie pareille. J'en reviens pas."~
@498=~"Annah ? Tu sais quelque chose sur le Fossé ?"~
@499=~"Une rivière à Sigil ? Comment est-ce possible ?"~
@501=~"Je... n'ai jamais enquêté. Je sais seulement qu'il n'est pas prudent pour les humains d'y nager. C'est à peu près tout."~
@502=~"Alors là, c'est *fort*, j'te le dis."~
@504=~"Annah ? Tu sais quelque chose sur le Fossé ?"~
@505=~"Tu as parlé de Nemezia ?"~
@506=~"Alors, qui a découvert le portail ?"~
@507=~"Pourquoi les autorités locales voudraient-elles détruire cette arche ?"~
@508=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@510=~"Tu crois qu'une petite tieffeline crasseuse et métisse..."~
@511=~"J'ai grandi *près* du Fossé. T'imagines même pas tout c'que j'en sais, espèce de fiélon pouilleux."~
@512=~"Alors oui, ça passe bien entre la Ruche et le Bas-Quartier, mais c'est pas une rivière. C'est un énorme égout dégueulasse et puant. Des fois, il est nettoyé quand un joli petit plan supérieur bien propre y déverse son trop-plein."~
@513=~"Parce que c'est ça, le Fossé : du jus de portail dégueulasse, les déchets de la Grande Fonderie et juste... de la merde. Des tonnes de merde."~
@514=~"J'ai entendu dire qu'il y avait aussi des endroits plus lumineux, plus encourageants. Peut-être même beaux ?"~
@515=~"Tout est pourri... Les Chutes du Suicide sont facilement c'qu'il y a de plus joli là-bas."Annah esquisse un léger sourire ironique."C'est là que ça tombe hors de la Cage, et c'est là qu'les pauvres bougres tristes vont mourir d'une mort romantique en s'jetant dans le néant."~
@516=~"Les matois racontent toujours qu'il y a un monstre dedans, mais c'est des foutaises."~
@518=~"Tu as parlé de Nemezia ?"~
@519=~"Alors, qui a découvert le portail ?"~
@520=~"Pourquoi les autorités locales voudraient-elles détruire cette arche ?"~
@521=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@523=~Tergush'tekhn soupire."Peu importe vraiment qui l'a découvert. Heureusement, nos associés ont trouvé ceux qui l'avaient trouvé avant que ceux qui recherchaient cette information ne les trouvent."~
@524=~"Mieux vaut ne pas penser au nombre de victimes que cette information a déjà coûté."~
@526=~"Tu as parlé de Nemezia ?"~
@527=~"Qu'est-ce que le Fossé ?"~
@528=~"Pourquoi les autorités locales voudraient-elles détruire cette arche ?"~
@529=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@531=~"Nous sommes en train d'en déterminer l'emplacement. L'un de nos espions fouille le Fossé à la recherche d'une"entrée". Cependant, nous ignorons quelle est la clé. Manohae n'avait aucun objet sur lui ; il a donc dû être dépouillé dès Cania."~
@532=~"Mais nous avons une piste !"~
@533=~"Il y a à la Salle des fêtes municipale une professeure appelée Mawu qui pourrait en savoir quelque chose", siffle le fiélon avec dégoût."C'est une experte des portes, passages et portails de toutes formes et de toutes tailles, mais..."Il regarde Tegar'in."Quelqu'un a réussi à faire interdire l'entrée de la Salle des fêtes municipale à tous les abishaïs pendant les QUARANTE prochains cycles. Alors *toi*, tu devras peut-être la rencontrer en premier."~
@534=~"Il n'en reste plus que trente-six !"~
@535=~"Va la rencontrer... apprends quelque chose sur un éventuel portail vers Cania, ou sur les portails itinérants en général. Reviens ensuite nous dire ce que tu as découvert."Il expire, emplissant l'air d'une odeur de soufre."Des questions ?"~
@537=~"Je crois avoir compris."~
@538=~"Oui. J'ai des questions."~
@540=~"Excellent. Alors va voir Mawu et reviens nous dire ce que tu auras appris."~
@543=~"Nous sommes en train d'en déterminer l'emplacement. L'un de nos espions fouille le Fossé à la recherche d'une"entrée". Cependant, nous ignorons quelle est la clé. Manohae n'avait aucun objet sur lui ; il a donc dû être dépouillé dès Cania."~
@544=~"Mais nous avons une piste !"~
@545=~"Il y a à la Salle des fêtes municipale une professeure appelée Mawu qui pourrait en savoir quelque chose", siffle le fiélon avec dégoût."C'est une experte des portes, passages et portails de toutes formes et de toutes tailles, mais..."Il regarde Tegar'in."Quelqu'un a réussi à faire interdire l'entrée de la Salle des fêtes municipale à tous les abishaïs pendant les QUARANTE prochains cycles. Alors *toi*, tu devras peut-être la rencontrer en premier."~
@546=~"Il n'en reste plus que trente-six !"~
@547=~"Va la rencontrer... apprends quelque chose sur un éventuel portail vers Cania, ou sur les portails itinérants en général. Reviens ensuite nous dire ce que tu as découvert."Il expire, emplissant l'air d'une odeur de soufre."Des questions ?"~
@550=~"D'accord. J'ai d'autres questions."~
@552=~Tergush'tekhn vous regarde avec stupéfaction, puis jette un coup d'œil aux deux autres abishaïs comme pour vérifier s'il s'agit d'une moquerie ou d'ignorance."Cania se trouve au plus profond des Enfers. C'est aussi le seul passage vers Nessus, la demeure d'Asmodée. La dissimuler aux visiteurs constitue une importante mesure de défense. Un raccourci permettant de contourner des défenses aussi colossales est inacceptable. Le fait qu'il s'agisse d'un portail itinérant empêche une invasion à grande échelle, mais de petites unités d'espionnage peuvent tout de même l'emprunter et contourner toute la hiérarchie. Exactement comme tu le feras. En théorie, c'est inacceptable !"~
@553=~"En pratique, toutefois, c'est extrêmement avantageux pour nous. Pour l'instant."~
@555=~"Tu as parlé de Nemezia ?"~
@556=~"Qu'est-ce que le Fossé ?"~
@557=~"Alors, qui a découvert le portail ?"~
@558=~"Donc... vous ne savez pas exactement où se trouve le portail à Sigil ?"~
@560=~L'abishaï rouge vous regarde avec stupéfaction. Il jette aussi un coup d'œil aux deux autres abishaïs, comme s'il cherchait une explication."Tu n'as pas reçu notre message ?"~
@561=~"Nous avons envoyé un messager !"~
@563=~"Non. De quoi s'agit-il ?"~
@564=~"Non."~
@565=~"Désolé, ça ne m'intéresse pas. Je suis entré ici par accident."~
@567=~Le fiélon soupire."Nous t'avons envoyé une lettre parce que nous avons un travail très important, tout spécialement pour toi. Veux-tu nous écouter ?"~
@569=~"Très bien. De quoi s'agit-il ?"~
@570=~"Désolé, ça ne m'intéresse pas. Je suis entré ici par accident."~
@572=~Le diable rouge paraît d'abord alarmé, mais retrouve aussitôt son calme."Ici, dans la Cage ? À ma recherche ? Il pourrait y avoir de nombreuses raisons. Nous n'en savons tout simplement rien."~
@573=~"Personne ne déteste davantage les fiélons que les autres fiélons, camarade."~
@574=~"Les archons détestent peut-être encore plus les fiélons que les autres fiélons."~
@575=~"Bon, d’accord. Personne ne déteste davantage les fiélons que les archons et les autres fiélons."~
@576=~"Je crois que les éladrins aussi..."~
@577=~"Ça suffit ! Oui, nous avons *beaucoup* d'ennemis. Il n'y a pas de quoi s'inquiéter."~
@579=~"Je l'espère vraiment. J'ai d'autres questions."~
