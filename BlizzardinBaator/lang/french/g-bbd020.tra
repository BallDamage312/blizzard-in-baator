@0=~"Laisse-moi tranquille, bipède."~
@3=~"Va donc embêter Orville."~
@6=~"Va donc embêter le nouveau tavernier."~
@9=~"Quoi ? Des voleurs ? Y a pas de voleurs ici."~
@12=~"Orville est un vrai affranchi."~
@15=~"Orville était un vrai affranchi."~
@18=~"C'est qui, ce squelette ? Il vient à chaque cycle, toujours à la même heure."~
@21=~"C'était qui, ce squelette ? Il venait à chaque cycle, toujours à la même heure."~
@24=~"Me dérange pas, j'essaie de me détendre."~
@27=~"Peut-être que je devrais aller à la plage."~
@30=~"Ces fous du temple recommencent à faire des leurs."~
