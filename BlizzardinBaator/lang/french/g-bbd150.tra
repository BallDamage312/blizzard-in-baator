@0=~Un gigantesque loup blanc veille sur son maître. La bête apprivoisée est impressionnante. Personne n'ose s'en approcher.~
@1=~Le loup aboie en vous voyant. ~ [g-wolf2]
@3=~Essayer de caresser le loup.~
@4=~Essayer de caresser le loup.~
@5=~Caresser le loup.~
@6=~"Sharikira. C'est qui le gentil toutou ?"~
@7=~"Sharikira. C'est qui le gentil toutou ?"~
@8=~"Va chercher !"~
@9=~Donner à manger au loup.~
@10=~Donner un coup de pied au loup.~
@11=~Laisser le loup tranquille.~
@13=~Le loup vous aboie dessus. ~ [g-wolf2]
@15=~Essayer de caresser le loup.~
@16=~Essayer de caresser le loup.~
@17=~Caresser le loup.~
@18=~"Sharikira. C'est qui le gentil toutou ?"~
@19=~"Sharikira. C'est qui le gentil toutou ?"~
@20=~"Va chercher !"~
@21=~Donner à manger au loup.~
@22=~Donner un coup de pied au loup.~
@23=~Laisser le loup tranquille.~
@25=~Un grondement bas mais puissant remplit la salle. Votre audace ne plaît pas au loup. Toute nouvelle tentative de le toucher pourrait mal finir. ~ [g-wolf3]
@27=~Réessayer.~
@28=~Lui donner un coup de pied.~
@29=~Laisser le loup tranquille.~
@31=~Le loup semble ravi et le fait savoir d'un bref aboiement. ~ [g-wolf2]
@33=~Jouer un peu avec le loup.~
@34=~"Sharikira ! C'est qui le gentil toutou ?"~
@35=~Laisser le loup tranquille.~
@37=~Vous avez mis le loup en colère ; il n'est donc guère surprenant qu'il vous attaque. Le signal est parfaitement clair pour son maître, et Ulfbrand ne risque pas de se précipiter à *votre* secours.~
@39=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@40=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@41=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@43=~Le loup encaisse un violent coup de pied et une expression de surprise traverse son noble museau. Il est trop grand pour que votre coup lui fasse réellement mal, mais il n'apprécie guère ce genre d'attention, pas plus que son maître. Tous deux vous montrent les dents. ~ [g-wolf8]
@45=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@46=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@47=~Fuir. ^N(Le combat est inutile car vous ne pouvez pas tuer Ulfbrand)^-~
@49=~Sharikira aboie joyeusement. Puisque vous l'avez appelé par son nom, vous pouvez désormais le caresser autant que vous le souhaitez. ~ [g-wolf2]
@51=~Jouer un peu avec le loup.~
@52=~Laisser le loup tranquille.~
@54=~Le loup aboie joyeusement. ~ [g-wolf2]
@56=~Jouer un peu avec le loup.~
@57=~Laisser le loup tranquille.~
@59=~Que voulez-vous lui lancer ?~
@61=~Lancer le fémur de fiélon.~
@62=~Lancer le fémur humain.~
@63=~Lancer le bâton chamanique fait avec la patte d'un grand oiseau.~
@64=~Malheureusement, vous n'avez rien à lui lancer.~
@65=~"Comment ça va ?"~
@66=~Laisser le loup tranquille.~
@68=~Le loup rapporte l'objet que vous lui avez lancé. Il semble ravi et le fait savoir d'un aboiement. ~ [g-wolf2]
@70=~Lancer le fémur de fiélon.~
@71=~Lancer le fémur humain.~
@72=~Lancer le bâton chamanique fait avec la patte d'un grand oiseau.~
@73=~Lancer le gros os qu'Agraval transportait.~
@74=~Malheureusement, vous n'avez rien à lui lancer.~
@75=~"Comment ça va ?"~
@76=~Laisser le loup tranquille.~
@78=~Que voulez-vous donner à manger au loup ?~
@80=~De la viande étrange.~
@81=~Du fromage.~
@82=~Une amulette en os. Autant lui donner quelque chose à mâcher.~
@83=~Le fémur de fiélon. Autant lui donner quelque chose à mâcher.~
@84=~Le fémur humain. Autant lui donner quelque chose à mâcher.~
@85=~Le bâton chamanique fait avec la patte d'un grand oiseau.~
@86=~Le gros os qu'Agraval transportait. Autant donner quelque chose à mâcher au loup.~
@87=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon béni.~
@88=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon sacré.~
@89=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon de Méchanus.~
@90=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon croquant.~
@91=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon à la menthe.~
@92=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon frémissant.~
@93=~Vous savez que c'est une mauvaise idée, mais lui donner du chocolat de Minauros.~
@94=~Vous savez que c'est une mauvaise idée, mais lui donner un bonbon porte-bonheur.~
@95=~Vous savez que c'est une mauvaise idée, mais lui donner du chocolat puant.~
