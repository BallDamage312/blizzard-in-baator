@0=~À l'étage supérieur de la bibliothèque, une petite femme mince à la peau bleue se tient près d'une étagère remplie de vieux grimoires poussiéreux, nullement troublée par l'absence de garde-corps sur la plate-forme. Absorbée dans sa lecture, elle ne prête aucune attention à ce qui l'entoure.~
@2=~"Salutations."~
@3=~Laisser la femme tranquille.~
@5=~La femme est toujours là, plongée avec attention dans l'ancien grimoire.~
@7=~"Bonjour de nouveau. J'ai quelques questions."~
@8=~Laisser la femme tranquille.~
@10=~La femme lève un doigt pour vous imposer le silence et hoche la tête pour elle-même en terminant un passage. Puis elle se tourne vers vous."Salutations, étrange individu. Vous avez besoin de quelque chose ?"~
@12=~"J'ai quelques questions."~
@13=~Laisser la femme tranquille.~
@15=~"Comme vous pouvez le voir, je suis un peu occupée. Je suis ici pour travailler, alors faites vite."~
@17=~"Qui êtes-vous ?"~
@18=~"Qui êtes-vous, déjà ?"~
@19=~"Pourquoi êtes-vous... bleue ?"~
@20=~"Qu'est-ce que vous lisez ?"~
@21=~"Vous avez terminé votre livre ?"~
@22=~"J'ai encore quelques questions à propos de cette histoire de"Tyché"."~
@23=~Lui montrer la Grande Pièce du Destin."Cette pièce a quelque chose à voir avec vos recherches ?"~
@24=~"J'ai décidé de vous vendre la Pièce du Destin. Quel prix aviez-vous proposé ?"~
@25=~"J'ai décidé de vous donner la Pièce du Destin. Elle devrait être entre vos mains."~
@26=~"Je vais bientôt aller à Méphistar, où l'on cache quantité de savoirs occultes. Peut-être pourrai-je y trouver quelque chose sur la scission de Tyché pour vous ?"~
@27=~"Je dois y aller."~
@29=~La couverture a souffert : l'un de ses coins a disparu et une partie du bord est brûlée. Le titre reste toutefois parfaitement lisible :"Histoire de la Pièce du Destin".~
@31=~"De quoi parle-t-il ?"~
@32=~"J'ai d'autres questions."~
@33=~"Je dois y aller."~
@35=~"C'est l'"Histoire de la Pièce du Destin". Ça faisait longtemps que je voulais mettre la main dessus. Très peu d'exemplaires semblent quitter le Plan Matériel Primaire. Ce livre traite de la destruction de la déesse Tyché."~
@37=~"Alors, comment a-t-elle été détruite ?"~
@38=~"J'ai d'autres questions."~
@39=~"Je dois y aller."~
@41=~La femme paraît un peu contrariée."Je... je ne vais *pas* vous résumer tout le livre comme ça. C'est une histoire assez compliquée. Et je dois le terminer. Dame Erin est impatiente de voir ce que je peux en tirer."~
@43=~"Qu'est-ce que vous voulez dire ?"~
@44=~"J'ai d'autres questions."~
@45=~"Je dois y aller."~
@47=~La femme soupire, légèrement agacée par vos interruptions répétées."Il y a environ un an, Dame Erin et son cercle rapproché ont été témoins d'un étrange événement grâce à mes yeux de scrutation. Un dieu idiot de leur panthéon a tenté de reconstituer Tyché. Apparemment, elle avait été sa maîtresse il y a des éons. Son plan a échoué, au grand désarroi assez étrange de nos Sensats, mais cela a éveillé leur intérêt pour la manière *exacte* dont Tyché s'était scindée en deux."~
@49=~"Qui est Dame Erin ?"~
@50=~"Qui était Tyché ?"~
@51=~"Alors, comment Tyché s'est-elle *exactement* scindée en deux ?"~
@52=~"Pourquoi la déception des Sensats était-elle étrange ?"~
@53=~"Vous êtes donc une puissante devineresse ?"~
@54=~"Je vois. J'ai encore quelques questions."~
@55=~"Je vois. Je dois y aller."~
@57=~La femme soupire, légèrement agacée par vos interruptions répétées."Qu'est-ce que vous voulez savoir ?"~
@59=~"Vous pouvez me rappeler ce qui s'est passé il y a un an ?"~
@60=~"Qui est Dame Erin ?"~
@61=~"Qui était Tyché ?"~
@62=~"Alors, comment Tyché s'est-elle *exactement* scindée en deux ?"~
@63=~"Pourquoi la déception des Sensats était-elle étrange ?"~
@64=~"Vous êtes donc une puissante devineresse ?"~
@65=~"Je vois. J'ai encore quelques questions."~
@66=~"Je vois. Je dois y aller."~
@68=~"Il y a environ un an, Dame Erin et son cercle rapproché ont été témoins d'un étrange événement grâce à mes yeux de scrutation. Un dieu idiot de leur panthéon a tenté de reconstituer Tyché. Apparemment, elle avait été sa maîtresse il y a des éons. Son plan a échoué, au grand désarroi assez étrange de nos Sensats, mais cela a éveillé leur intérêt pour la manière *exacte* dont Tyché s'était scindée en deux."~
@70=~"Qui est Dame Erin ?"~
@71=~"Qui était Tyché ?"~
@72=~"Alors, comment Tyché s'est-elle *exactement* scindée en deux ?"~
@73=~"Pourquoi la déception des Sensats était-elle étrange ?"~
@74=~"Vous êtes donc une puissante devineresse ?"~
@75=~"Je vois. J'ai encore quelques questions."~
@76=~"Je vois. Je dois y aller."~
@78=~"Vous plaisantez ? Erin Sombreflamme Montgomery est l'une des personnes les plus connues de Sigil. Elle est factol et grande réformatrice de la Société des Sensations, ainsi qu'une brillante diplomate qui œuvre au bénéfice de tous les citoyens."~
@80=~"Très bien, alors qui était Tyché ?"~
@81=~"Alors, comment Tyché s'est-elle *exactement* scindée en deux ?"~
@82=~"Pourquoi la déception des Sensats devant l'échec de la reconstitution de Tyché était-elle étrange ?"~
@83=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@84=~"Je vois. J'ai encore quelques questions."~
@85=~"Je vois. Je dois y aller."~
@87=~"Tyché était une ancienne déesse olympienne de la chance et de la malchance. Son culte était très répandu et s'était étendu à de nombreuses sphères du Plan Matériel Primaire."~
@89=~"Et qui est Dame Erin ?"~
@90=~"Alors, comment s'est-elle scindée en deux ?"~
@91=~"Pourquoi la déception des Sensats devant l'échec de sa reconstitution était-elle étrange ?"~
@92=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@93=~"Je vois. J'ai encore quelques questions."~
@94=~"Je vois. Je dois y aller."~
@96=~Elle soupire et passe une main dans ses cheveux."Ce n'est pas très clair. Les sources se contredisent. Le plus probable est que Tyché ait été infectée par quelque chose de malveillant et que l'hôtesse des Portes de la Lune, la déesse Séluné, l'ait tuée par compassion. Mais au lieu de disparaître, elle s'est scindée en Tymora, pure, et Beshaba, corrompue. Deux nouvelles déesses, respectivement de la bonne et de la mauvaise fortune."~
@98=~"Qui est Séluné ?"~
@99=~"Qui est Tymora ?"~
@100=~"Qui est Beshaba ?"~
@101=~"Ah, alors qui était Tyché ?"~
@102=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@103=~"Alors pourquoi la déception des Sensats à l'idée de voir cette scission annulée était-elle étrange ?"~
@104=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@105=~"Je vois. J'ai encore quelques questions."~
@106=~"Je vois. Je dois y aller."~
@108=~"C'est également une Puissance ancienne. Certains prétendent qu'elle est elle aussi le résultat de la scission d'une autre entité, mais ce ne sont peut-être que des rumeurs propagées par d'autres Puissances pour la rabaisser. Elle fait partie des *bonnes*. Pour nous autres planaires, elle est surtout connue comme l'hôtesse des Portes de la Lune en Ysgard, là où l'Escalier infini prend racine."~
@110=~"Et qui est Tymora ?"~
@111=~"Et qui est Beshaba ?"~
@112=~"Ah, alors qui était Tyché ?"~
@113=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@114=~"Alors pourquoi la déception des Sensats à l'idée de voir cette scission annulée était-elle étrange ?"~
@115=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@116=~"Je vois. J'ai encore quelques questions."~
@117=~"Je vois. Je dois y aller."~
@119=~"Tymora est une proche alliée des Sensats. C'est une déesse de la bonne fortune qui réside à Eauclaire, cité divine abritant une communauté de plusieurs excellentes déesses, en Arborée. On trouve également non loin une forteresse sensat."~
@120=~"Je n'ai jamais eu l'occasion de visiter Eauclaire moi-même, mais j'ai entendu dire que c'était un lieu magnifique."~
@122=~"Et qui est Séluné ?"~
@123=~"Et qui est Beshaba ?"~
@124=~"Ah, alors qui était Tyché ?"~
@125=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@126=~"Alors pourquoi la déception des Sensats à l'idée de voir cette scission annulée était-elle étrange ?"~
@127=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@128=~"Je vois. J'ai encore quelques questions."~
@129=~"Je vois. Je dois y aller."~
@131=~"Beshaba est le revers de la médaille de Tymora. C'est une déesse corrompue et malveillante de la mauvaise fortune. Elle réside dans les Abysses. Elle est assez étrange..."La femme s'interrompt, comme si elle venait de tomber sur une information fascinante qu'elle se réjouit enfin de partager. Elle sourit avant de poursuivre."Sur certains mondes, il existe une coutume assez folle consistant à la prier avant chaque mariage et à l'inviter à la cérémonie. Comme elle est malveillante, elle ne vient jamais lorsqu'on l'invite. Ainsi, la prière garantit aux jeunes mariés qu'aucun malheur ne les frappera. Mais toutes ces prières augmentent tout de même sa puissance. C'est un système de culte étrangement efficace..."~
@132=~"Donc elle force ses fidèles à la prier pour qu'elle ne fasse *absolument rien*. Elle est brillante."~
@134=~"Et qui est Séluné ?"~
@135=~"Et qui est Tymora ?"~
@136=~"Ah, alors qui était Tyché ?"~
@137=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@138=~"Alors pourquoi la déception des Sensats à l'idée de voir cette scission annulée était-elle étrange ?"~
@139=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@140=~"Je vois. J'ai encore quelques questions."~
@141=~"Je vois. Je dois y aller."~
@143=~"Ah."Cette question semble la troubler légèrement."Les Sensats étaient très enthousiastes à l'idée d'assister à la renaissance d'une déesse. L'expérience aurait été exceptionnelle. Mais la fusion a été interrompue et Tymora comme Beshaba sont restées séparées, alors nous avons été déçus..."Après une longue pause, elle ajoute :"Mais aussi soulagés, vous savez ? Perdre une alliée aurait déjà été regrettable, mais fusionner deux déesses contre leur volonté ne nous paraissait vraiment pas juste."~
@144=~"Je me souviens de cette histoire. Je n'étais pas là pour voir le complot s'effondrer, mais j'ai entendu dire que cela avait tout de même été assez spectaculaire."~
@146=~"Alors, qui est Séluné ?"~
@147=~"Alors, qui est Tymora ?"~
@148=~"Alors, qui est Beshaba ?"~
@149=~"Ah, alors qui était Tyché ?"~
@150=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@151=~"Vous espionniez donc des dieux ? Vous êtes une puissante devineresse ?"~
@152=~"Je vois. J'ai encore quelques questions."~
@153=~"Je vois. Je dois y aller."~
@155=~Elle laisse échapper un bref rire excédé."Oui. Oui, j'en suis une. Et non, je ne fournis *pas* de services de scrutation. Même pas un jour de congé, et aujourd'hui n'en est *certainement* pas un. Je suis ici pour mes recherches."~
@157=~"Mais je cherche quelqu'un qui est perdu dans les Enfers. Cela me rendrait un grand service."~
@158=~"Vous me devez un service pour la Pièce du Destin, vous vous souvenez ?"~
@159=~"Alors, qui est Séluné ?"~
@160=~"Alors, qui est Tymora ?"~
@161=~"Alors, qui est Beshaba ?"~
@162=~"Ah, alors qui était Tyché ?"~
@163=~"Vous avez parlé de Dame Erin. Qui est-ce ?"~
@164=~"Je vois. J'ai encore quelques questions."~
@165=~"Je vois. Je dois y aller."~
@167=~"Désolée. Même si je voulais vous aider, il me faudrait l'infrastructure appropriée et du temps. Revenez peut-être me voir dans une semaine pour *prendre* rendez-vous. Ensuite, je pourrais peut-être effectuer la scrutation... dans un mois environ ?"~
@169=~"Alors oublions ça. Vous avez parlé de Séluné. Qui est-ce ?"~
@170=~"Alors oublions ça. Vous avez parlé de Tymora. Qui est-ce ?"~
@171=~"Alors oublions ça. Vous avez parlé de Beshaba. Qui est-ce ?"~
@172=~"Alors oublions ça. Vous avez parlé de Tyché. Qui est-ce ?"~
@173=~"Alors oublions ça. Vous avez parlé de Dame Erin. Qui est-ce ?"~
@174=~"Je vois. J'ai encore quelques questions."~
@175=~"Je vois. Je dois y aller."~
@177=~"Je m'appelle Ayryn Farlight et je suis une spécialiste sensat de la scrutation. Je suis ici pour étudier ce livre ; si vous n'avez rien d'urgent, j'apprécierais que vous me laissiez poursuivre."~
@178=~"Salutations, ma sœur."~
@179=~"Je..."balbutie-t-elle."Je ne veux vraiment pas paraître grossière, mais je ne souhaite pas passer davantage de temps que nécessaire dans ce quartier."~
@180=~"Dame Grâce ! Je ne vous avais pas vue. Salutations à vous aussi. Je suis vraiment désolée, je ne veux pas paraître grossière, mais je ne souhaite pas passer davantage de temps que nécessaire dans ce quartier."~
@181=~"Ce n'est pas l'endroit le plus agréable de la ville, mais il offre quelques expériences uniques, notamment dans le domaine olfactif des sensations."~
@182=~La femme rit."Tout à fait."~
@184=~"Je vois. J'ai encore quelques questions."~
@185=~"Je vois. Je dois y aller."~
@187=~Elle pousse un profond soupir et sa peau bleue s'assombrit."Vous vous souvenez quand je vous ai dit que je n'avais pas le temps de parler ? Je n'ai certainement pas le temps de *me présenter de nouveau*. Je m'appelle Ayryn Farlight et je suis une spécialiste sensat de la scrutation. Tâchez de vous en souvenir, cette fois."~
@189=~"Je vois. J'ai encore quelques questions."~
@190=~"Je vois. Je dois y aller."~
@192=~"Vous avez vraiment parcouru toute cette ville sans jamais rencontrer un seul génasi ? Je suis une génasi de l'air, nous avons la peau bleue. C'est assez courant."Cette question semble véritablement l'étonner.~
@194=~"Qu'est-ce qu'un génasi ?"~
@195=~"En fait, je n'en ai jamais rencontré. Mais j'ai encore quelques questions."~
@196=~"Je vois. Je dois y aller."~
@198=~"Ah, vous êtes un béjaune. Vous n'en avez pas l'air, désolée. Les génasis sont des gens dont une partie de l'ascendance vient des Plans Intérieurs. Ma grand-mère, par exemple, venait du Plan Élémentaire de l'Air. C'est comparable aux cornes ou à la queue des tieffelins. Nous avons la peau bleue et un teint parfait."~
@200=~"Je vois. J'ai encore quelques questions."~
@201=~"Je vois. Je dois y aller."~
@203=~"Si c'était le cas... je ne serais *plus* ici. Je ne le tiendrais pas devant mes yeux à en examiner le contenu, n'est-ce pas ? Et vous ne seriez pas en train de m'interrompre tandis que j'essaie d'élucider ce mythe."~
@205=~"Au fait, de quoi parle ce livre ?"~
@206=~"En fait, j'ai encore quelques questions à propos de cette histoire de Tyché."~
@207=~"Je vois. J'ai encore quelques questions."~
@208=~"Je vois. Je dois y aller."~
@210=~"Une visite dans les bibliothèques de Méphistar ? Ce serait impressionnant, si c'est vrai. J'ai du mal à croire que vous puissiez en revenir vivant, mais si vous y parvenez et apprenez quelque chose d'utile pour nous, la Société vous paiera très généreusement. J'aurai sûrement terminé ce livre d'ici là, alors cherchez-moi simplement à la Salle des fêtes municipale."~
@212=~"Avant ça, j'ai encore quelques questions à propos de cette histoire de Tyché."~
@213=~"Je ferai ce que je peux. J'ai encore quelques questions."~
@214=~"Je ferai ce que je peux. Je dois y aller."~
@216=~Ses yeux brillants s'écarquillent et un large sourire apparaît sur son visage."Oui... et non. C'est un symbole aussi bien de Tymora que de Beshaba, l'un de leurs précieux artefacts. Des pièces de ce genre sont dispersées dans les Plans, mais c'est toujours un plaisir d'en revoir une."~
@217=~"Nous en possédons une dans les collections de la Société. Elle ne contient aucune information nouvelle, mais..."Ayryn retient son souffle et vous regarde droit dans les yeux."Accepteriez-vous de me la vendre ? Ce serait merveilleux d'en posséder une, car elle constitue un *excellent* ingrédient pour de puissants sorts."~
@219=~"Attendez. Si c'est un artefact puissant, à quoi peut-il servir ?"~
@220=~"La vendre ? Pour combien ?"~
@221=~"Si elle vous est aussi utile, prenez-la gratuitement."~
@222=~"Dans ce cas, je préfère la garder. Mais j'ai d'autres questions."~
@223=~"Dans ce cas, je préfère la garder. Je dois partir maintenant."~
@225=~Ayryn feuillette le livre qu'elle tient, à la recherche du bon passage."Ah, oui, chapitre quatre", dit-elle en arrêtant son doigt sur une page avant de commencer à lire.~
@226=~"Les Pièces du Destin, héritage de Tyché, incarnent à la fois les murmures de la fortune et de l'infortune, et ce rare défi par lequel un être ose saisir son destin de ses propres mains. En vain leur chercherait-on quelque usage ordinaire ou conventionnel ; pourtant, aux heures noyées de crainte, dans ces instants tremblants où le sort d'une chose précieuse ne tient qu'à un fil, lorsqu'un unique choix doit être fait — un choix dont dépendra le destin de beaucoup — lancer une telle pièce place les possibilités de l'existence sur un pied d'égalité. Ce qui semblait presque impossible devient l'égal de ce qui paraissait assuré au-delà de tout doute. Et le cœur accueille-t-il toujours avec joie le résultat d'un tel lancer ? Certainement pas. Qu'il soit bienvenu ou funeste, une vérité demeure inébranlable : le résultat sera absolument, *inexorablement*, imprévisible."~
@227=~Ayryn relève les yeux des pages de son livre."C'est un artefact risqué. Au combat, il pourrait faire davantage de mal que de bien. Il me serait plus utile pour mes recherches. Accepteriez-vous de me le vendre ?"~
@229=~"La vendre ? Pour combien ?"~
@230=~"Si elle vous est aussi utile, prenez-la gratuitement."~
@231=~"Dans ce cas, je préfère la garder. Mais j'ai d'autres questions."~
@232=~"Dans ce cas, je préfère la garder. Je dois partir maintenant."~
@234=~"Je n'ai pas beaucoup d'argent sur moi, puisque ce quartier est plutôt louche, mais je peux aller chercher dans mon coffre personnel quelque chose que vous pourrez revendre très cher n'importe où. Une pierre précieuse des Plans Supérieurs : un diamant empyréen. Elle vaut une fortune, et cela fait une éternité que je ne m'en sers plus comme focaliseur de sort."~
@236=~"Ça me va. Marché conclu."~
@237=~"Si elle vous est aussi utile, prenez-la gratuitement."~
@238=~"Dans ce cas, je préfère la garder. Mais j'ai d'autres questions."~
@239=~"Dans ce cas, je préfère la garder. Je dois partir maintenant."~
@241=~Ayryn prend la pièce avec un large sourire et la fait tourner entre ses doigts comme si elle n'arrivait pas à croire qu'elle lui appartient. Soudain, telle une prestidigitatrice de rue, elle effectue un geste habile et la pièce disparaît, probablement dans le coffre mentionné plus tôt. Des vapeurs violettes tourbillonnent un instant autour de sa main et, en un clin d'œil, un second geste semblable fait apparaître dans sa paume une grosse gemme chatoyant de toutes les couleurs de l'arc-en-ciel.~
@242=~Sa main bleue se tend vers la vôtre et la gemme change de propriétaire. Elle est légère, plus légère que vous ne l'auriez imaginé, mais cela ne diminue en rien l'impression qu'elle produit.~
@244=~"Merci. J'ai d'autres questions."~
@245=~"Merci. Je dois partir maintenant."~
@247=~"Vraiment !?"La bouche de la génasi s'entrouvre de stupeur. Pendant un instant, aucun son n'en sort tandis qu'elle encaisse la nouvelle."Merci ! C'est un cadeau vraiment précieux... Je vous en dois une, étranger."~
@249=~"Dans ce cas, vous pourriez peut-être m'aider à localiser quelqu'un que je cherche à Méphistar ?"~
@250=~"Je m'en souviendrai. Mais pour l'instant, j'ai d'autres questions."~
@251=~"Je m'en souviendrai. Je dois partir maintenant."~
@253=~Ayryn soupire."Très bien. C'est la moindre des choses... Que pouvez-vous me dire à son sujet ?"~
@255=~"C'est une érinye, la compagne de Levistus, vue pour la dernière fois à Méphistar, en Cania. Elle porte une armure rouge."~
@256=~"Elle est jolie, a été vue pour la dernière fois à Méphistar, en Cania, et porte une armure rouge."~
@258=~La femme vous lance un regard sévère."C'est... une plaisanterie ? Vous ne savez rien d'autre ? Vous n'avez aucun objet lui appartenant ? J'aimerais vraiment vous aider, mais ce n'est tout simplement pas suffisant..."~
@260=~"Eh bien... merci d'avoir essayé. J'ai d'autres questions."~
@261=~"Eh bien... merci d'avoir essayé. Je dois partir maintenant."~
@262=~"Vous êtes inutile. Je m'en vais."~
@264=~Ayryn soupire, comme si les informations restaient insuffisantes, mais un morceau d'acier bleu se matérialise dans sa main et elle ferme les yeux. Son corps reste immobile une douzaine de secondes, mais vous avez l'impression que son esprit s'est éloigné très loin.~
@265=~Après un long moment, elle rouvre les yeux et, durant une fraction de seconde, la bibliothèque paraît un peu plus froide."Il y a beaucoup d'érinyes à Méphistar. Certaines portent du rouge... Mais je ne perçois chez aucune d'elles de lien avec Levistus, même si cela ne signifie pas forcément grand-chose. Peut-être que les sentiments qu'on lui prête pour lui sont fortement exagérés. Je sais..."La femme s'attriste."Je sais que ce n'était pas beaucoup d'informations, mais vous ne m'en avez pas donné beaucoup non plus. Je suis désolée de ne pas avoir pu faire davantage."~
@267=~"Eh bien... merci d'avoir essayé. J'ai d'autres questions."~
@268=~"Eh bien... merci d'avoir essayé. Je dois partir maintenant."~
@269=~"Vous êtes inutile. Je m'en vais."~
