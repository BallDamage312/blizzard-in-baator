@0=~Vous voyez un homme à la peau jaune et desséchée, au visage farouche mais légèrement ennuyé. Il ne semble guère vous prêter attention. On pourrait croire qu'il médite ou réfléchit profondément. Rien chez lui n'a quoi que ce soit de démoniaque. Il ne donne pas l'impression d'être originaire des Enfers.~
@1=~Vous avez déjà vu des gens comme lui. Vous *savez* donc que vous avez devant vous un membre du Peuple : un githzeraï. Une race chaotique venue du royaume perpétuellement changeant des Limbes, où, d'après Dak'kon, ils façonnent des cités par la pensée. Ce que l'un d'eux fait à Baator reste toutefois un mystère : il ne semble subir aucun tourment ici. Vous observez le calme stoïque caractéristique d'un githzeraï.~
@3=~"J'ai quelques questions."~
@4=~(Le saluer en faisant référence à la culture gith.)"La parenté de Zerchaï s'incline devant toi."~
@5=~(Son calme stoïque vous irrite. L'attaquer.)~
@6=~(Partir avant qu'il ne vous remarque.)~
@8=~Un homme à la peau jaune et desséchée et au visage farouche, légèrement ennuyé, se tourne vers vous."Y a-t-il des choses que tu souhaites *connaître* ?"~
@10=~"J'ai quelques questions."~
@11=~(Le saluer en faisant référence à la culture gith.)"La parenté de Zerchaï s'incline devant toi."~
@12=~(Son calme stoïque vous irrite. L'attaquer.)~
@13=~(Partir avant qu'il ne vous remarque.)~
@15=~"Et le voyageur en est honoré."Le gith s'incline à son tour avec tout le respect dû. Vous avez fait bonne impression.~
@17=~"Il y a des choses que je souhaite *connaître*."~
@18=~(Après l'avoir salué, partir.)~
@20=~"K'atzn'ii près de la Porte. Je t'écouterai, voyageur. *Connais* toutefois ceci : tout ne m'est pas *connu*, surtout sur cette terre étrangère."~
@22=~"Qu'est-ce que tu fais ici ?"~
@23=~"Tu es githzeraï, n'est-ce pas ? Que peux-tu me dire sur ton peuple ?"~
@24=~(Désigner Dak'kon.)"Je voyage avec l'un de tes compatriotes. Il y a une chance que vous vous connaissiez ?"~
@25=~"Que sais-tu de Cania ? Devrais-je me méfier ?"~
@26=~"*Connais*-tu le Cercle ininterrompu de Zerthimon ?"~
@27=~"Que penses-tu de mon groupe ?"~
@28=~"J'aimerais parler de mes voyages."~
@29=~"Laisse tomber. Adieu."~
@31=~"Nous accomplissons un pèlerinage des Limbes jusqu'à la Cité des Âmes Perdues, en Cania. Sensei Dharvana a visité notre monastère et prêché les enseignements de l'Homme Endormi. Ce voyage mettra nos corps à l'épreuve et fortifiera nos âmes. Il a été prédit que notre pèlerinage durerait encore trois ans, alors même que nous sommes presque arrivés."~
@33=~"Où se trouvent les Limbes ?"~
@34=~"La Cité des Âmes Perdues ?"~
@35=~"Qui est Sensei Dharvana ?"~
@36=~"Qui est l'Homme Endormi ?"~
@37=~"Une prédiction ? De quelle prophétie parles-tu ?"~
@38=~"Revenons à mes autres questions..."~
@39=~"Laisse tomber. Adieu."~
@41=~Les yeux de l'homme s'illuminent soudain à la mention de son foyer."Les Limbes sont un Plan isolé, anarchique et imprévisible du côté le moins ordonné de la Grande Roue. Un lieu de chaos pur, où tout est en mouvement et en changement constants, surtout le paysage, qui peut se déplacer sans prévenir et se transformer à volonté comme un liquide. Il existe peu d'endroits assez stables pour les voyageurs. Les Limbes sont le foyer des slaads et de leurs seigneurs Ygorl et Ssendam, ainsi que des githzeraïs. Très peu de divinités s'y installent, car le Plan ne possède aucune structure permanente. On y rencontre aussi parfois des Xaositectes de la cité de Xaos, incapables de rentrer chez eux faute de volonté suffisante."~
@43=~"La Cité des Âmes Perdues ?"~
@44=~"Qui est Sensei Dharvana ?"~
@45=~"Qui sont les slaads ?"~
@46=~"Tu as parlé d'une prophétie."~
@47=~"Revenons à mes autres questions..."~
@48=~"Laisse tomber. Adieu."~
@50=~"C'est là que se trouve le temple de l'Homme Endormi. À l'extérieur de ce havre de paix et d'illumination, des pécheurs accomplissent de pénibles travaux dans les carrières de glace pour le contremaître Gru'ul et d'autres diables. Il y a l'Auberge du Feu infernal pour les gens libres, mais l'endroit est loin d'être éclairé."~
@52=~"Où se trouvent les Limbes ?"~
@53=~"Qui est Sensei Dharvana ?"~
@54=~"Qui est l'Homme Endormi ?"~
@55=~"Tu as parlé d'une prophétie."~
@56=~"Revenons à mes autres questions..."~
@57=~"Laisse tomber. Adieu."~
@59=~"Sensei signifie : maître. Elle s'appelle Dharvana. En plus d'être prêtresse et gardienne de l'Homme Endormi, c'est une psioniste : elle lit dans l'esprit des gens. Elle y a consacré toute sa vie."~
@61=~"Où se trouvent les Limbes ?"~
@62=~"La Cité des Âmes Perdues ?"~
@63=~"Qui est l'Homme Endormi ?"~
@64=~"Tu as parlé d'une prophétie."~
@65=~"Revenons à mes autres questions..."~
@66=~"Laisse tomber. Adieu."~
@68=~"L'Homme Endormi est un planétar céleste, une créature du bien. Et un arpenteur. Il est rare de rencontrer un céleste descendant volontairement dans les Neuf Enfers. À part peut-être Trias. Ils descendent plus souvent sur le Plan Matériel Primaire, comme Dame Aylin. Voilà une chose que les célestes ont en commun avec les fiélons : ils aiment engendrer une descendance avec les mortels. Ils feraient bien mieux de pratiquer l'ascèse et l'abstinence. Encore faut-il reconnaître que, sur ce point, les fiélons ne sont pas hypocrites."Il regarde autour de lui d'un air conspirateur. Vous avez l'impression qu'il vient de se montrer un peu trop franc.~
@70=~"Encore un nom ? Qui est Trias ?"~
@71=~"J'ai déjà rencontré Trias. Que sais-tu de lui ?"~
@72=~"J'ai rencontré Trias le Traître. Et j'ai causé sa perte."~
@73=~"Encore un autre nom ? Qui est Aylin ?"~
@74=~"Tu as parlé de la Cité des Âmes Perdues, non ?"~
@75=~"Où se trouvent les Limbes ?"~
@76=~"Tu as parlé d'une prophétie."~
@77=~"Revenons à mes autres questions..."~
@78=~"Laisse tomber. Adieu."~
@80=~"Sensei Dharvana affirme que, dans trois ans, un mort de Toril capable de résoudre le mystère des Vrais Noms et de réveiller l'Homme Endormi viendra en Cania."Le pèlerin vous observe attentivement un instant, comme s'il se demandait si elle parlait de vous."Mais tu arrives trop tôt. Ce n'est pas ta prophétie."Vous auriez juré le voir sourire en coin, mais son visage a déjà retrouvé sa lassitude habituelle.~
@82=~"Où se trouvent les Limbes ?"~
@83=~"La Cité des Âmes Perdues ?"~
@84=~"Qui est Sensei Dharvana ?"~
@85=~"Qui est l'Homme Endormi ?"~
@86=~"Revenons à mes autres questions..."~
@87=~"Laisse tomber. Adieu."~
@89=~Le pèlerin hausse les épaules."L'Ach'ali qui se noie... Je ne sais pas grand-chose de lui. J'ai seulement entendu parler d'un déva qui discutait avec des diables. Ce n'est pas normal, même lorsqu'on est habitué à l'imprévisibilité des Limbes. Le bien et le mal sous des formes aussi extrêmes... ils sont inconciliables. Son sort m'est toutefois indifférent."~
@91=~"Les Limbes ?"~
@92=~"La Cité des Âmes Perdues ?"~
@93=~"Qui est Sensei Dharvana ?"~
@94=~"Qui est l'Homme Endormi ?"~
@95=~"Revenons à mes autres questions..."~
@96=~"Laisse tomber. Adieu."~
@98=~"Certains des Cercles me sont *connus*."~
@100=~"Je veux t'interroger sur certains Cercles."~
@101=~"J'ai encore des questions..."~
@102=~"Laisse tomber. Adieu."~
@104=~L'homme paraît quelque peu perplexe. Il jette un regard à vos compagnons."Formule clairement tes questions."~
@106=~"Que penses-tu de Morte ?"~
@107=~"Que penses-tu de Dak'kon ?"~
@108=~"Que penses-tu d'Annah ?"~
@109=~"Que penses-tu de Grâce ?"~
@110=~"Que penses-tu d'Ignus ?"~
@111=~"Que penses-tu de Vhailor ?"~
@112=~"Que penses-tu de Nordom ?"~
@113=~"Que penses-tu de Gemariel ?"~
@114=~"Que penses-tu de Fury ?"~
@115=~"Que penses-tu de moi ?"~
@116=~"J'ai encore des questions..."~
@117=~"Laisse tomber. Adieu."~
@119=~"N'est-ce pas un habitant originel de Baator ? Je le sens. Quelques strates au-dessus se trouve le Pilier des Crânes. Cela fait toujours mal d'y voir des membres du Peuple. Aucune race n'est exempte de mensonge, cependant. Même les célestes travestissent parfois la vérité."~
@121=~"Je veux t'interroger sur quelqu'un d'autre."~
@122=~"J'ai encore des questions..."~
@123=~"Laisse tomber. Adieu."~
@125=~"Son nom m'est *connu*. Mais il ne fait *pas* partie du Peuple. Cette affaire est toutefois aussi tortueuse que les racines de Fri'hi. Nous n'avons pas le temps d'en explorer les nuances."~
@127=~"Je veux t'interroger sur quelqu'un d'autre."~
@128=~"J'ai encore des questions..."~
@129=~"Laisse tomber. Adieu."~
@131=~"Tu ne manques pas de courage pour amener quelqu'un portant du sang tanar'ri à Baator. Je le reconnais à sa queue."Ayant remarqué le regard meurtrier d'Annah, il détourne les yeux. Son regard, comme il sied à un moine, est toutefois dépourvu de désir ; il ne fait qu'observer la réalité."Mais ce sang fiélon peut l'aider à survivre au froid. Si tant est qu'on puisse parler d'avantage au sang fiélon."~
@133=~"Je veux t'interroger sur quelqu'un d'autre."~
@134=~"J'ai encore des questions..."~
@135=~"Laisse tomber. Adieu."~
@137=~"Je crains qu'en amenant une tanar'ri à Baator, tu ne condamnes ta compagne à mort."Ses paroles ne contiennent aucun mépris, mais il est difficile d'y discerner une véritable compassion."Mais si tu l'as fait, tu es sûrement assez préparé pour la défendre."~
@139=~"Je veux t'interroger sur quelqu'un d'autre."~
@140=~"J'ai encore des questions..."~
@141=~"Laisse tomber. Adieu."~
@143=~"Emmener un homme consumé par une flamme inextinguible dans un enfer glacé était un choix stratégique, voyageur. Peut-être qu'ici sa passion brûlante fera davantage de bien que de mal."~
@145=~"Je veux t'interroger sur quelqu'un d'autre."~
@146=~"J'ai encore des questions..."~
@147=~"Laisse tomber. Adieu."~
@149=~"La Loi incarnée. Je préfère *ne pas* être jugé par lui."répond-il en ignorant le regard farouche de Vhailor.~
@151=~"Je veux t'interroger sur quelqu'un d'autre."~
@152=~"J'ai encore des questions..."~
@153=~"Laisse tomber. Adieu."~
@155=~"Un modrone renégat ? Ne faisait-il pas partie du groupe égaré en Cania pendant la Grande Marche des Modrones ? Tu pourrais les trouver quelque part dans les environs. Quelle ironie. Des êtres venus de tous les côtés de la Grande Roue sont attirés vers les profondeurs des Enfers : des githzeraïs des Plans du Chaos, des modrones des Plans de la Loi, l'Homme Endormi, planétar des Plans du Bien... et maintenant même toi, un Sigilien, je suppose. Encore que je soupçonne que tu as vu bien plus de Plans que moi au cours de ton pèlerinage. Rencontrer un modrone renégat revient à trouver une petite faille dans un système, un bug juridique permettant l'existence d'un être qui nie sa propre nature. Voilà une preuve de la nature ultimement et toujours plus chaotique du Multivers."~
@157=~"Je veux t'interroger sur quelqu'un d'autre."~
@158=~"Des modrones ? Ici, en Cania ?"~
@159=~"Laisse tomber. Adieu."~
@161=~"C'est ton guide ? Il est difficile de trouver meilleur guide de Baator qu'un baatezu. Et pire également. Assure-toi que ton accord avec lui prévoit tous les scénarios imprévisibles. Sinon, tu pourrais te réveiller un jour avec une chaîne autour du cou et des fers aux poignets, occupé à pelleter la merde de nupperibos."~
@163=~"Je veux t'interroger sur quelqu'un d'autre."~
@164=~"J'ai encore des questions..."~
@165=~"Laisse tomber. Adieu."~
@167=~"En temps normal, te voir avec une érinye me ferait dire que ton cas est désespéré. Mais quelque chose me dit que tu sais ce que tu fais. Au moins dans une certaine mesure."~
@169=~"Je veux t'interroger sur quelqu'un d'autre."~
@170=~"J'ai encore des questions..."~
@171=~"Laisse tomber. Adieu."~
@173=~"Je vois un homme qui ne se *connaît* pas lui-même. D'où toutes ces questions."~
@175=~"En fait, je me demandais si tu aimais mon apparence."~
@176=~"Je veux t'interroger sur quelqu'un d'autre."~
@177=~"J'ai encore des questions..."~
@178=~"Laisse tomber. Adieu."~
@180=~Le moine vous fixe de ses yeux noirs comme le charbon."Il est bon d'être maître de son corps. Il est bon d'être maître de ses paroles. Il est bon d'être maître de son esprit. Il est bon d'être maître de toute chose. Celui qui renonce et se maîtrise en tout se libérera de la souffrance."Vous êtes presque certain qu'il cite un noble saint.~
@182=~"Très bien, je veux t'interroger sur quelqu'un d'autre..."~
@183=~"J'ai encore des questions..."~
@184=~"Laisse tomber. Adieu."~
@186=~"De quel Cercle parles-tu, voyageur ?"~
@188=~"Premier Cercle de Zerthimon. La puissance réside dans la connaissance de soi. J'ai appris que celui qui ne se *connaît* pas est perdu. Il devient un outil entre les mains d'autrui. Es-tu d'accord ?"~
@189=~"Deuxième Cercle de Zerthimon. Ne pas *connaître* quelque chose peut être un outil, comme la chair ou l'acier, si l'on tente d'en *connaître* la nature et la manière dont cela est apparu. Qu'en penses-tu ?"~
@190=~"Troisième Cercle de Zerthimon. Endure. Dans l'endurance, deviens plus fort."~
@191=~"Quatrième Cercle de Zerthimon. L'Œil de Vilquar. Celui qui choisit de ne voir que ce qui se trouve devant lui ne perçoit qu'une partie du tout."~
@192=~"Cinquième Cercle de Zerthimon. La puissance de l'Un réside dans le fait de *connaître*."~
@193=~"Sixième Cercle de Zerthimon. L'équilibre en toute chose. Voilà comment résumer les enseignements de Zerthimon dans ce Cercle."~
@194=~"Septième Cercle de Zerthimon. Le temps n'est pas un ennemi, mais un allié. C'est l'arme la plus puissante qui puisse exister. Si nous survivons à nos ennemis, nous vaincrons. C'est ainsi que les esclaves peuvent triompher de leurs maîtres."~
@195=~"Huitième Cercle de Zerthimon, le dernier. Il ne suffit pas de se *connaître* et d'y puiser sa force ; par la concentration, on peut également révéler les faiblesses de son ennemi. La concentration de Zerthimon vient du véritable fait de *connaître*."~
@196=~"Assez parlé du Cercle ininterrompu. J'ai d'autres questions."~
@197=~"Laisse tomber. Adieu."~
@199=~"J'entends tes paroles. Ô pauvres êtres qui ne se *connaissent* pas eux-mêmes. Car ils se noieront dans l'incommensurable chaos des Limbes."~
@201=~"Je veux parler d'un autre Cercle."~
@202=~"J'ai encore des questions..."~
@203=~"Laisse tomber. Adieu."~
@205=~"Naturellement, le fait de *connaître* n'existe pas sans sa racine. Tu as donc raison : il doit exister un état reconnu *avant* la connaissance. Et cet état appartient à celui qui l'emploie, en façonnant le sien. Mais prends garde : on ne peut revenir à l'état où l'on ne connaissait pas."~
@207=~"Je veux parler d'un autre Cercle."~
@208=~"J'ai encore des questions..."~
@209=~"Laisse tomber. Adieu."~
@211=~"J'entends tes paroles. Je sens que le simple son de ta voix me rend plus fort."~
@213=~"Je veux parler d'un autre Cercle."~
@214=~"J'ai encore des questions..."~
@215=~"Laisse tomber. Adieu."~
@217=~"C'est vrai. Malheureusement, tant de gens semblent se contenter de voir ce qui les arrange. Ils n'essaient pas d'aller plus loin. Ils n'évoluent pas. Ils ne s'en donnent pas l'occasion. Ils ne voient que la nourriture, la reproduction et la volonté de ceux qui sont plus forts qu'eux s'opposant à ceux qui défendent d'autres croyances. Voilà le véritable esclavage : l'abandon volontaire de sa volonté afin de se priver de souffrance. Il n'existe pas de plus grand ennemi de la liberté que des esclaves heureux."~
@219=~"Je veux parler d'un autre Cercle."~
@220=~"J'ai encore des questions..."~
@221=~"Laisse tomber. Adieu."~
@223=~"J'entends tes paroles."~
@225=~"Je veux parler d'un autre Cercle."~
@226=~"J'ai encore des questions..."~
@227=~"Laisse tomber. Adieu."~
@229=~"Tu le vois, n'est-ce pas, voyageur ? Comme le chaos avec la loi. Comme le bien avec le mal. Rompre cet équilibre ne mène pas à une issue favorable. Je crois que tu commences déjà à percevoir ce troisième axe apparemment invisible des conséquences de tes décisions. Celui que tu ne peux pas mesurer, mais dont tu peux seulement observer les effets réels dans un Multivers vieillissant."~
@231=~"Je veux parler d'un autre Cercle."~
@232=~"J'ai encore des questions..."~
@233=~"Laisse tomber. Adieu."~
@235=~"Et ainsi, les maîtres peuvent opprimer un peuple entier pendant des millénaires, comme l'ont fait les *illithids*. Tu as raison, c'est une observation valable."~
@237=~"Je veux parler d'un autre Cercle."~
@238=~"Peux-tu m'en dire davantage sur les illithids ?"~
@239=~"Laisse tomber. Adieu."~
@241=~"C'est une connaissance intuitive, mais ce n'est qu'en comprenant tout le processus de concentration que tu pourras en tirer le maximum. On dirait que tu as appris l'intégralité du Cercle. C'est inhabituel pour quelqu'un qui n'est pas githzeraï. Qu'un étranger puisse comprendre ce que sont réellement les Cercles était... inconcevable pour moi auparavant. Mais après t'avoir parlé, je vois que tu en es digne. Va et vis. Découvre ta véritable nature, arpenteur."~
@243=~"Je veux parler d'un autre Cercle."~
@244=~"J'ai encore des questions..."~
@245=~"Laisse tomber. Adieu."~
@247=~"Dame Aylin est une aasimar, fille de la déesse Séluné, la Vierge Lunaire. Aylin a été emprisonnée dans le Plan de l'Ombre. Les modrones échoués ici, en Cania, ont calculé qu'elle y restera encore deux siècles. Terrible destin. Les races à la longue vie connaissent des tourments inconnus des mortels."~
@249=~"J'ai entendu dire que Séluné avait tué Tyché qui, au lieu de disparaître, s'est divisée entre la bonne Tymora et la malveillante Beshaba."~
@250=~"De quoi Séluné est-elle la déesse ?"~
@251=~"Des modrones ? Ici, en Cania ?"~
@252=~"Que sais-tu du Plan de l'Ombre ?"~
@253=~"Parle-moi davantage de cette Aylin."~
@254=~"Revenons à mes autres questions..."~
@255=~"Laisse tomber. Adieu."~
@257=~"Séluné est une déesse chaotique bonne d'Ysgard. Ses fidèles l'appellent la Dame d'Argent ; elle est également connue sous les noms de Vierge Lunaire et de Dame Blanche de la Nuit. Si tu remarques un motif, tu as raison : c'est une déesse particulièrement importante pour les femmes, puisqu'elle règne sur la Lune et les menstruations. Ses domaines comprennent également la protection et les voyages, alors si tu cherches une divinité protectrice pour ta petite odyssée, elle pourrait convenir. D'un autre côté, elle est aussi liée aux lycanthropes et à la folie. Tu vois, même le bien possède de nombreuses nuances, surtout lorsqu'il se mêle au chaos. Une visite en Cania peut t'apprendre que les êtres que tu rencontres ne se réduisent pas à l'axe du bien contre le mal et à celui de la loi contre le chaos. La vie est bien plus compliquée."~
@259=~"Et c'est la mère d'Aylin ? Que lui est-il arrivé ?"~
@260=~"Des modrones ? Ici, en Cania ?"~
@261=~"Que sais-tu du Plan de l'Ombre ?"~
@262=~"Parle-moi davantage de cette Aylin."~
@263=~"Revenons à mes autres questions..."~
@264=~"Laisse tomber. Adieu."~
@266=~"Un rouage s'est détaché de Méchanus. Comme tu le sais probablement, les modrones et les githzeraïs occupent des côtés opposés de la Grande Roue. D'un côté, des êtres loyaux soumis à la volonté unanime de l'ordre ; de l'autre, des individualistes spirituels qui plient le chaos à *leur* volonté. Lorsque le nombre de rouages ne fut plus correct, ils firent tout pour récupérer celui qui manquait. Ils l'ont payé de leur liberté et ont fini en enfer. Si tant est qu'ils aient jamais possédé cette liberté. Ne crois pas que nous soyons ennemis pour autant. Leur vision du monde est différente, mais ce sont malgré tout des êtres vivants."~
@268=~"De quoi Séluné est-elle la déesse ?"~
@269=~"Des modrones ? Ici, en Cania ?"~
@270=~"Que sais-tu du Plan de l'Ombre ?"~
@271=~"Parle-moi davantage de cette Aylin."~
@272=~"Revenons à mes autres questions..."~
@273=~"Laisse tomber. Adieu."~
@275=~"Le Plan de l'Ombre, également appelé Gisombre, est un Plan Transitoire incolore qui constitue un écho du Plan Matériel Primaire. C'est le domaine de la déesse Shar, la sœur maléfique de Séluné. Certaines créatures et certains mages peuvent l'utiliser pour voyager. Il peut également constituer une prison redoutable. On connaît des cas de arpenteurs transformés en créatures d'ombre, leur nature ayant été modifiée. Physiquement, du moins. Mentalement, je ne crois pas que le sujet ait encore été suffisamment étudié."~
@277=~"Il existe donc deux divinités jumelles, Séluné et Shar ?"~
@278=~"Des modrones ? Ici, en Cania ?"~
@279=~"Que sais-tu du Plan de l'Ombre ?"~
@280=~"Parle-moi davantage de cette Aylin."~
@281=~"Revenons à mes autres questions..."~
@282=~"Laisse tomber. Adieu."~
@284=~"Dame Aylin, le Chant de la Nuit. Ses ailes sont l'héritage de son sang céleste. Elle servait sa mère Séluné en tant que paladine. Elle est tombée amoureuse d'Isobel Thorm, une demi-elfe qui est malheureusement morte. Le père de celle-ci et son conseiller Balthazar ont enlevé Aylin et l'ont emprisonnée dans une cage d'âme en Gisombre au nom de Shar."~
@286=~"De quoi Séluné est-elle la déesse ?"~
@287=~"De quoi Shar est-elle la déesse ?"~
@288=~"Que sais-tu du Plan de l'Ombre ?"~
@289=~"Parle-moi davantage de cette Aylin."~
@290=~"Revenons à mes autres questions..."~
@291=~"Laisse tomber. Adieu."~
@293=~"Maîtresse de la Nuit, Dame de la Perte, Déesse Sombre, Dame Sombre. Le nom même de Shar signifie"mal". C'est une divinité neutre mauvaise représentant les ténèbres primordiales, opposées à la lumière que reflète la Lune de Séluné. Elle détruit, séduit et intrigue. Elle dissimule d'innombrables secrets. Ses fidèles recherchent égoïstement la vengeance et nourrissent leur ressentiment."~
@295=~"Et Séluné ?"~
@296=~"Tu sembles en savoir beaucoup sur des choses venues de différents Plans. Grâce à tes pèlerinages ?"~
@297=~"Que sais-tu du Plan de l'Ombre ?"~
@298=~"Parle-moi davantage de cette Aylin."~
@299=~"Revenons à mes autres questions..."~
@300=~"Laisse tomber. Adieu."~
@302=~"C'est vrai. Plus nous apprenons de détails apparemment sans rapport sur le Multivers, mieux nous comprenons le monde. Et nous n'avons pas besoin de les cataloguer comme ces modrones condamnés aux Enfers. Nous devons les *connaître*, mais je veux dire réellement les *connaître*. Leur essence. Leur nature."~
@304=~"C'est bien un githzeraï qui parle de *connaître* les choses. Que peux-tu me dire sur ton peuple ?"~
@305=~"Tu sembles en savoir beaucoup sur des choses venues de différents Plans. Grâce à tes pèlerinages ?"~
@306=~"Que sais-tu du Plan de l'Ombre ?"~
@307=~"Parle-moi davantage de cette Aylin."~
@308=~"Revenons à mes autres questions..."~
@309=~"Laisse tomber. Adieu."~
@311=~"Nous sommes le Peuple. Nous avons subi l'esclavage des *illithids* et fait la guerre aux githyankis, ceux dont le régime n'était qu'une prolongation de celui de leurs anciens maîtres. Ils se sont installés sur le Plan Astral, nous dans les Limbes, où nous avons appris la difficile coexistence avec les slaads au sein d'un chaos en perpétuel changement."~
@313=~"Alors qu'est-ce que tu fous en... enfer ?"~
@314=~"Qui sont les illithids ?"~
@315=~"Qui sont les slaads ?"~
@316=~"À quoi ressemblent les Limbes ?"~
@317=~"*Connais*-tu le Cercle ininterrompu de Zerthimon ?"~
@318=~(Désigner Dak'kon.)"Je voyage avec l'un de tes compatriotes. Il y a une chance que vous vous connaissiez ?"~
@319=~"Laisse tomber. Adieu."~
@321=~"Les flagelleurs mentaux, les ghaiks, envahisseurs sadiques venus de Penumbra. Ils dévorent littéralement le cerveau de leurs victimes tout en étendant les frontières de leur empire interplanaire. Celui-ci englobait non seulement les Plans Astral et Éthéré, mais aussi d'innombrables planètes du Plan Matériel Primaire, dont une célèbre base dans l'Outreterre, et même les marges des Plans Extérieurs. Cela a duré un temps inconcevable, avant même que l'histoire ne commence à être consignée. Ils voyageaient autrefois sur des vaisseaux appelés nautiloïdes. Pour te donner une idée de la menace qu'ils représentaient jadis, imagine que les archidiables des Neuf Enfers furent un jour contraints d'interrompre leur campagne dans la Guerre Sanglante pour répondre à l'expansion des *illithids*."~
@322=~"Pourtant, plus un empire est vaste, plus le risque de rébellion grandit. Les maîtres les dominaient grâce à leurs pouvoirs psioniques, mais au fil des millénaires les esclaves ont commencé à changer, à évoluer et à développer une résistance. Avant la division, Gith et Vlaakith, qui allait plus tard diriger les traîtres githyankis, combattaient aux côtés de Zerthimon et de son successeur Zaerith Menyar-Ag-Gith contre leurs oppresseurs. La menace était si grande que les deux cieux ne formaient alors qu'un. Aujourd'hui, les ghaiks ne sont plus qu'une fraction de leur puissance passée. Cela ne signifie pourtant pas que le danger ait disparu. Tant qu'il restera un seul *illithid*, il cherchera à asservir et à implanter ses têtards, se souvenant de l'immensité de l'empire d'autrefois."~
@324=~"Alors qu'est-ce que tu fous en... enfer ?"~
@325=~"Qui sont les githzeraïs ?"~
@326=~"Qui sont les slaads ?"~
@327=~"Que sais-tu de Cania ? Devrais-je me méfier ?"~
@328=~"Le Cercle ininterrompu de Zerthimon raconte l'histoire de cet esclavage. Le *connais*-tu ?"~
@329=~(Désigner Dak'kon.)"Je voyage avec l'un de tes compatriotes. Il y a une chance que vous vous connaissiez ?"~
@330=~"Laisse tomber. Adieu."~
@332=~"Les slaads sont les habitants chaotiques et batraciens des Limbes. Si ce savoir t'est utile, leur couleur détermine leur rang dans la hiérarchie, un peu comme chez les abishaïs. Pour les slaads, cela donne : vaseux, rouge, bleu, vert, gris, mort, blanc, puis, s'ils survivent plusieurs siècles, ils peuvent devenir des slaads noirs, de véritables abîmes en forme de crapaud. Une puissance à ne pas sous-estimer. Il existe aussi les gorméels, des slaads dissidents dont la nature est opposée à celle de leur peuple ; certains se cachent même parmi les githzeraïs, car, parias chez les leurs, les autres slaads les chassent pour s'amuser. Voilà la leçon : le chaos est si imprévisible que même en son sein peut naître la loi. Mais ne dis pas cela aux modrones. Ils affirmeraient exactement l'inverse."~
@334=~"Les modrones ? Tu veux dire ici, en Cania ?"~
@335=~"Qui sont les illithids ?"~
@336=~"Qui sont les githzeraïs ?"~
@337=~"À quoi ressemblent les Limbes ?"~
@338=~"*Connais*-tu le Cercle ininterrompu de Zerthimon ?"~
@339=~(Désigner Dak'kon.)"Je voyage avec l'un de tes compatriotes. Il y a une chance que vous vous connaissiez ?"~
@340=~"Laisse tomber. Adieu."~
@342=~"En plus de l'évidence, c'est-à-dire la protection contre le froid, méfie-toi avant tout des baatezus. Tu rencontreras sûrement des cornugons et des gelugons accompagnés de fiélons mineurs. Mais puisque tu es arrivé jusqu'ici, je suppose que les lémures ne t'effraient pas."~
@344=~"J'ai visité l'Averne. Comment Cania peut-elle être si différente ? Nous sommes toujours à Baator, non ?"~
@345=~"Malgré tout, la masse informe mais encore vaguement humaine d'un lémure me terrifie davantage que quelques lézards géants."~
@346=~"Cania ressemble-t-elle au Valbise ?"~
@347=~"J'ai d'autres questions."~
@348=~"Laisse tomber. Adieu."~
@350=~"Cet endroit ne m'est pas *connu*. Si je me souviens bien, il se trouve quelque part sur le Plan Matériel Primaire. Je ne me suis jamais aventuré au-delà des Plans Extérieurs. J'accomplis mes pèlerinages à pied aussi souvent que possible. J'évite de voyager par les conduits. Enfin, un conduit astral serait peut-être nécessaire pour s'y rendre. Quoi qu'il en soit, les conditions d'ici sont certainement beaucoup plus rudes. Les hivers du Primaire ne ressemblent en rien à ceux des Plans Extérieurs, et je suppose qu'il en va de même pour la comparaison que tu proposes."~
@352=~"Parlons des Plans. J'ai visité de nombreux endroits."~
@353=~"J'ai d'autres questions."~
@354=~"Laisse tomber. Adieu."~
@356=~"Dis-moi où tes voyages t'ont conduit et je te dirai qui tu es."~
@358=~"Je suis allé à Sigil, la Cité des Portes."~
@359=~"Je suis allé dans l'un des labyrinthes de la Dame des Douleurs, et j'ai réussi à en sortir."~
@360=~"Je suis allé dans les Limbes, mais dans un fragment organisé comme Méchanus par des modrones."~
@361=~"Je suis allé dans le Labyrinthe aux Épines Noires de Ravel."~
@362=~"Je suis allé à Maudith, la ville-portail de Carcères."~
@363=~"Je suis allé dans les Outreterre. J'ai vu le grand squelette de très près."~
@364=~"Je suis allé en Averne. Comment Cania peut-elle être si différente ? Nous sommes toujours à Baator, non ?"~
@365=~"Je suis allé en Carcères et j'ai réussi à en sortir."~
@366=~"J'ai d'autres questions."~
@367=~"Laisse tomber. Adieu."~
@369=~"Qui ne l'a pas été, voyageur ? À Sigil, d'innombrables routes se croisent. Certains affirment qu'elle pourrait être le centre du Multivers."~
@371=~"J'ai visité d'autres endroits."~
@372=~"J'ai d'autres questions."~
@373=~"Laisse tomber. Adieu."~
@375=~"Il paraît qu'il existe une sortie cachée dans chaque labyrinthe. Beaucoup pensent que ce n'est qu'une rumeur destinée à donner de faux espoirs. Mais peut-être contient-elle malgré tout une part de vérité."~
@377=~"J'ai visité d'autres endroits."~
@378=~"J'ai d'autres questions."~
@379=~"Laisse tomber. Adieu."~
@381=~"Une contradiction faite contradiction. Un chaos ordonné. Tu devrais voir les Limbes dans leur état naturel lorsque tu auras suffisamment entraîné ta volonté."~
@383=~"J'ai visité d'autres endroits."~
@384=~"J'ai d'autres questions."~
@385=~"Laisse tomber. Adieu."~
@387=~"La guenaude nocturne ? On disait qu'elle venait des Gaste Grise. Si tu as un jour espéré qu'elle exauce tes souhaits, j'espère que tu n'as jamais essayé de les lui demander."~
@389=~"J'ai visité d'autres endroits."~
@390=~"J'ai d'autres questions."~
@391=~"Laisse tomber. Adieu."~
@393=~"Un endroit traître. Un nid de serpents. Tu sais de quoi je parle. Il existe une immense prison sous terre, mais en réalité la cité en constitue le premier niveau sans que ses habitants ne s'en rendent compte."~
@395=~"J'ai visité d'autres endroits."~
@396=~"J'ai d'autres questions."~
@397=~"Laisse tomber. Adieu."~
@399=~"J'y ai voyagé moi aussi. Mais cet endroit est si vaste que le squelette dont tu parles ne m'évoque absolument rien."~
@401=~"J'ai visité d'autres endroits."~
@402=~"J'ai d'autres questions."~
@403=~"Laisse tomber. Adieu."~
@405=~"Les Plans sont extraordinaires, voyageur. Même des strates voisines peuvent parfois être radicalement différentes. Et Baator lui-même comprend à la fois Cania et Stygie, deux terres glacées."~
@407=~"Parlons des Plans. J'ai visité de nombreux endroits."~
@408=~"J'ai d'autres questions."~
@409=~"Laisse tomber. Adieu."~
@411=~"Tu as de la chance, voyageur. Il est bien plus difficile de s'échapper des Plans du Chaos."~
@413=~"J'ai visité d'autres endroits."~
@414=~"J'ai d'autres questions."~
@415=~"Laisse tomber. Adieu."~
@417=~"Rien d'étonnant, voyageur. Ce qui nous effraie le plus est ce qui se situe entre ce qui nous ressemble et ce qui nous attend après la mort. Les autres baatezus, aussi terrifiants soient-ils, sont difficiles à imaginer comme notre avenir. Mais les lémures, les nupperibos, sans parler des larves... Voilà un avenir potentiel plus proche. Je *comprends* ce que tu veux dire."~
@419=~"Parlons des Plans. J'ai visité de nombreux endroits."~
@420=~"J'ai d'autres questions."~
@421=~"Laisse tomber. Adieu."~
@423=~"Terrifiante perspective que de perdre si complètement la *connaissance* de soi au point de devenir deux entités nouvelles et radicalement opposées. Qu'en penses-tu ? C'est mon interprétation. Je ne crois pas qu'il s'agisse d'une intervention divine. Quelque chose de plus sinistre a dû changer sa nature. Je me demande parfois quoi, mais finalement, c'est peut-être un aspect du Multivers qu'il vaut mieux ne pas explorer sans nécessité absolue."~
@425=~"De quoi Séluné est-elle la déesse ?"~
@426=~"Que sais-tu des modrones en Cania ?"~
@427=~"Que sais-tu du Plan de l'Ombre ?"~
@428=~"Parle-moi davantage de cette Aylin."~
@429=~"Revenons à mes autres questions..."~
@430=~"Laisse tomber. Adieu."~
