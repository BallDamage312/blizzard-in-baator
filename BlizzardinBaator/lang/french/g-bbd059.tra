@471=~Les deux dés montrent un."Deux as. Désolé, tu as perdu."~ [NAM062]
@473=~"Je veux réessayer."~
@474=~"Rappelle-moi les règles."~
@475=~"J'ai changé d'avis. J'ai quelques questions."~
@476=~"Je vais partir."~
@478=~"Trois. Désolé, tu as perdu."~ [NAM062]
