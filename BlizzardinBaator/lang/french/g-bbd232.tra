@0=~"Moufles de laine bien chaudes ! Tissus et matériaux ! Chapeaux ! Venez acheter vos vêtements !"~
@3=~"Moufles de laine bien chaudes ! Tissus et matériaux ! Chapeaux ! Venez acheter vos vêtements !"~
@5=~"Vous connaissez un gith du nom d'Ikss'odes ? Il paraît qu'il vit dans le coin."~
@6=~"Salutations. Une femme en robe rouge vous a vendu des vêtements récemment ?"~
@7=~"Salutations. En fait, j'aimerais racheter ces vêtements. Ceux que la femme en robe rouge vous a vendus."~
@8=~Partir.~
@10=~"Vêtements neufs, vêtements d'occasion. Tout c'que votre cœur désire. Et oui, elle m'en a vendu."~
@12=~"Je peux les racheter ?"~
@13=~Partir.~
@15=~"Bien sûr. Vingt-cinq pièces de cuivre le tout."~
@17=~"Je les prends."~
@18=~"J'ai changé d'avis. Adieu."~
@20=~"Les voilà."Elle échange votre argent contre une chemise soigneusement pliée et un pantalon, puis recommence à crier plus fort que les autres marchands."Moufles de laine bien chaudes ! Tissus et matériaux ! Chapeaux ! Venez acheter vos vêtements !"~
@30=~La marchande désigne les bâtiments à droite du chronomètre."Le gith bizarre ? C'est ce bâtiment-là, mais ça fait un moment que j'l'ai pas vu. Demandez à sa copine, Mare."~
@32=~"Très bien, où puis-je la trouver ?"~
@35=~"Elle traîne généralement près de la Mer Verticale."~
@37=~"Où est-ce ?"~
@38=~"Merci. Je dois partir. Adieu."~
@40=~"Plus loin de l'eau, derrière la statue d'Athéna."~
@42=~"Merci. Je dois partir. Adieu."~
