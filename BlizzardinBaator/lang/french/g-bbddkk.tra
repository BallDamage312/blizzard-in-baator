@0=~Dak'kon se tourne vers vous, les yeux semblables à du charbon poli."Quelle est ta volonté ?"~ [DAK205]
@2=~"Je veux seulement savoir si tu vas bien, Dak'kon."~
@3=~"Quelle est notre voie actuelle, Dak'kon ? Rappelle-moi."~
@4=~"Attends-moi ici. Je reviendrai te chercher."~
@5=~"Rien. Allons-y."~
@7=~"Si telle est ta volonté, je resterai ici, mais savoir si je pourrai repartir seul... cela, je ne le *connais* pas."~
@9=~"Ce n'est pas mon problème. Tu devras m'attendre ici."~
@10=~"Tu as raison. Laisse tomber, alors. Allons-y."~
@12=~Dak'kon semble réfléchir un instant à votre situation.~
@13=~"Nous sommes exposés. Rester ici serait imprudent. Je ne *connais* pas notre sécurité."~
@15=~"Je veux parler d'autre chose."~
@16=~"Très bien. Allons-y."~
@18=~Dak'kon vous lance un regard perplexe.~
@19=~"Nous devons trouver l'abishaï, Gemariel. Il doit nous servir de guide ici."~
@20=~"Nous devons trouver l'abishaï, Gemariel. Il doit nous servir de guide ici. Nous ne devrions pas nous attarder. Si le barde nous a trouvés, d'autres sont peut-être proches."~
@22=~"Je veux parler d'autre chose."~
@23=~"Très bien. Allons-y."~
