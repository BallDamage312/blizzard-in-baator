@0=~"Hé, le bleu ! Viens par ici !"~
@3=~Un individu âgé se tient près d'un panneau d'annonces mal fichu, vêtu de vêtements autrefois élégants mais désormais décrépits. Il observe attentivement tous les passants et tente de les héler, mais chacun l'évite. Lorsqu'il vous voit approcher, il s'anime soudain, apportant avec lui la forte odeur d'un corps jamais lavé."B'soin d'quelque chose, patron ? Adrean peut mettre la main sur n'importe quoi."~
@5=~"Qui es-tu ?"~
@6=~"Pourquoi m'as-tu appelé"le bleu"?"~
@7=~"J'ai quelques questions..."~
@8=~"Je dois partir. Adieu."~
@10=~Adrean vous voit arriver à une lieue et semble ravi de votre retour."Patron ! Qu'est-ce qu'il vous faut ce cycle-ci ?"~
@12=~"Rappelle-moi... qui es-tu ?"~
@13=~"J'ai quelques questions..."~
@14=~"Je dois partir. Adieu."~
@16=~Adrean inspire profondément d'un air théâtral, le visage illuminé par un sourire de fripouille."Moi, Adrean, j'suis, patron, *LE* meilleur foutu indic de toute cette fourmilière. Aucun autre bige m'arrive à la cheville. Je connais *TOUT* et *TOUT LE MONDE*."~
@18=~"Alors j'ai quelques questions."~
@19=~"Je dois partir. Adieu."~
@21=~Adrean inspire profondément d'un air théâtral, le visage illuminé par un sourire de fripouille."Un bleu, dans mon jargon, c'est du sang neuf. Et moi, Adrean, j'suis, patron, *LE* meilleur foutu indic de toute cette fourmilière. Aucun autre bige m'arrive à la cheville. Je connais *TOUT* et *TOUT LE MONDE*."~
@23=~"Alors j'ai quelques questions."~
@24=~"Je dois partir. Adieu."~
@26=~L'homme s'incline mais garde la main droite levée, index pointé."J'répondrai avec plaisir à TOUTES vos questions. Reste juste la question d'mes honoraires. Mon guide excluuusif vaut deux dizaines de pièces de cuivre. Prix d'ami ! Ni plus ni moins."~
@28=~"Vingt cuivres ? Très bien."~
@29=~"C'est du vol. Je ne paierai pas autant."~
@30=~"Je n'en ai pas les moyens. Je dois partir. Adieu."~
@32=~Adrean fronce les sourcils et mâchonne nerveusement quelque chose qui semble être apparu dans sa bouche."À peine vingt, c'est trop pour un arpenteur des Plans comme vous, patron ?"~
@34=~"Tu as raison. Je peux payer."~
@35=~"Et dix ?"~
@36=~"J'ai seulement quelques questions simples. Je n'ai pas besoin d'une grande visite guidée."~
@37=~"Et dix ?"~
@38=~"J'ai seulement quelques questions simples. Je n'ai pas besoin d'une grande visite guidée."~
@39=~"Je n'en ai pas les moyens. Je dois partir. Adieu."~
@41=~Adrean fronce violemment les sourcils et crache sur le pavé sale."Puisse l'ombre de la Dame passer loin de vous."~
@44=~Adrean sourit avec un certain charme, dévoilant une dentition noircie et très incomplète."Demandez n'importe quoi."~
@46=~"Que peux-tu me dire sur cet endroit ?"~
@47=~"On peut trouver du travail ici ?"~
@48=~"Quelles sont les dernières nouvelles du coin ?"~
@49=~"Reparle-moi de l'imp capturé."~
@50=~"Reparle-moi des disparitions."~
@51=~"Rappelle-moi l'histoire de cette plage."~
@52=~"Qu'est-ce qu'il y a déjà avec le secteur inondé ?"~
@53=~"C'était quoi, ces grands fiélons ?"~
@54=~"Qui est Joseph ?"~
@55=~"Tu as parlé du tréteau de Zaddfum ?"~
@56=~"Marché ? Grand Bazar ? Négoce ?"~
@57=~"Rivergate ne se trouvait pas ici à l'origine ?"~
@58=~"Tu sais comment éviter le portail de Rivergate ?"~
@59=~"Tu sais comment éviter le portail de Rivergate ?"~
@60=~"Tu connais un gith du nom d'Ikss'odes ? Il paraît qu'il vit par ici."~
@61=~"Tu sais quelque chose sur un portail vers les Enfers dans le coin ?"~
@62=~"Je dois partir. Adieu."~
@64=~Les yeux d'Adrean brillent de joie tandis qu'il contemple le quartier sale et nauséabond entourant le Fossé."C'est l'plus bel endroit de toute la Cage. C'est là que vivent les VRAIS matois, pas des pigeons peinturlurés. Le Fossé, c'est le sang d'cette ville. C'est ici que s'passent les choses les plus importantes de tout l'Multivers."~
@65=~"Vers le tréteau de Zaddfum, y a notre marché, meilleur repaire à bonnes affaires que l'Grand Bazar... p't-être même meilleur que Négoce... et Rivergate, c'est un vrai sanctuaire pour les connaisseurs de bouges portuaires. On n'en fait plus des comme ça, c'est grandiose que les dabus l'aient déplacé ici."~
@67=~"Tu as parlé du tréteau de Zaddfum ?"~
@68=~"Marché ? Grand Bazar ? Négoce ?"~
@69=~"Rivergate ne se trouvait pas ici à l'origine ?"~
@70=~"Tu sais comment éviter le portail de Rivergate ?"~
@71=~"Tu sais comment éviter le portail de Rivergate ?"~
@72=~"Je vois. J'ai une autre question..."~
@73=~"Je dois partir. Adieu."~
@75=~"Ha ! Du travail. Ici, on vit pas du travail, mais d'la ruse."Adrean montre l'autre côté du Fossé."Les pigeons, eux, travaillent d'l'autre côté d'l'eau."~
@77=~"Logique. J'ai une autre question."~
@78=~"Je dois partir. Adieu."~
@80=~"Les dernières ? Hmm. Les gars de Joseph ont attrapé un imp et ils s'amusent avec."~
@81=~"Et puis, deux ou trois gros lascars ont disparu dernièrement. Le genre qui disparaît pas tout seul."~
@82=~"Et bien sûr, y a notre nouvelle destination touristique : la *plage*. La seule de Sigil."~
@83=~"Quoi d'autre... Ah, un groupe de gros démons traîne dans l'coin. Ils cherchent des hommes-rats. Mais les rats sont introuvables, alors les fiélons cherchent juste les ennuis en attendant qu'ils ressortent."~
@84=~"Oh, et encore un truc. La ronce-rasoir du secteur inondé s'étend vers l'intérieur des terres ces derniers temps. Certains sont vraiment pas contents."~
@86=~"Dis-m'en plus sur l'imp capturé."~
@87=~"Parle-moi des disparitions."~
@88=~"C'est quoi, cette histoire de plage ?"~
@89=~"Qu'est-ce qui se passe dans le secteur inondé ?"~
@90=~"C'était quoi, ces grands fiélons ?"~
@91=~"Je vois. J'ai une autre question..."~
@92=~"Je dois partir. Adieu."~
@94=~"Les gars de Joseph, à Rivergate, l'ont attrapé. Ils disent qu'il nous espionnait, mais pour qui... ça, personne sait. Enfin, les gars vont lui apprendre qu'on rôde pas dans notre repaire sans conséquence."~
@96=~"Je vois. J'ai une autre question..."~
@97=~"Je dois partir. Adieu."~
@101=~"J'en sais pas des masses. Juste que deux ou trois gros lascars ont disparu dernièrement, des gars qui seraient sans doute pas partis d'eux-mêmes. Ça sentait l'poisson là où ils avaient disparu. Mais bon, ici c'est l'Fossé. Ça devrait surprendre personne. C'est seulement l'odeur qui est bizarre. Elle vient d'la plage depuis quelque temps..."~
@103=~"Je vois. J'ai une autre question..."~
@104=~"Je dois partir. Adieu."~
@106=~"C'est notre nouvelle destination touristique. La seule dans tout Sigil. Juste d'l'autre côté d'la place. Je la recommande *chaleureusement*."Adrean vous adresse un clin d'œil exagérément lent. Lorsqu'il rouvre l'œil, celui-ci regarde légèrement de travers.~
@108=~"C'est vraiment l'endroit le plus chaud de Sigil ?"~
@109=~"Je vois. J'ai une autre question..."~
@110=~"Je dois partir. Adieu."~
@112=~"J'en doute. Les fourneaux d'la Grande Fonderie sont sûrement plus chauds, mais tu peux pas t'y allonger sur une couverture, hein ?"~
@114=~"Donc ce n'est pas spécialement chaud ?"~
@115=~"Je vois. J'ai une autre question..."~
@116=~"Je dois partir. Adieu."~
@118=~Adrean se penche pour murmurer, vous enveloppant d'une forte odeur d'alcool bon marché."C'est plus chaud ! Y a un portail sous l'sable. Vers le Feu Élémentaire, j'crois, même si certains disent que ça mène à un Plan inférieur."~
@120=~"Donc probablement pas Cania. J'ai une autre question..."~
@121=~"Donc probablement pas Cania... Je dois partir. Adieu."~
@123=~"C'est un pont au-dessus du Fossé."Adrean montre une ruelle étroite où tant de vêtements pendent au-dessus des têtes qu'ils forment une sorte de toit."Par là... mais depuis ici, tu peux pas vraiment y aller sans nager."~
@125=~"Je vois. J'ai une autre question..."~
@126=~"Je dois partir. Adieu."~
@128=~"Quoi, t'es tombé d'Yggdrasil ? Notre marché est *formidable* et il est juste ici. Le Grand Bazar, c'est un piège à riches plein de lanceurs de sorts bouffis dans l'Quartier des Marchés."Il s'interrompt."Négoce, c'est une ville-portail vers Bytopie, au pied d'la Flèche."~
@130=~"Yggdrasil, Bytopie, la Flèche... attends..."~
@131=~"Je vois. J'ai une autre question..."~
@132=~"Je dois partir. Adieu."~
@134=~"Ouh là, patron, moi j'fais l'indic qu'autour du Fossé. Trouvez-vous un indic arpenteur des Plans pour des questions pareilles."~
@136=~"Je vois. J'ai une autre question..."~
@137=~"Je dois partir. Adieu."~
@139=~"Avant, il était sur la Voie de la Croûte. Les dabus l'ont déplacé ici y a quelques années. Meilleure décision qu'ces têtes de chèvre aient jamais prise."~
@141=~"Je vois. J'ai une autre question..."~
@142=~"Je dois partir. Adieu."~
@144=~Adrean soupire."Demande à Brill..."~
@146=~"Merci. J'ai une autre question..."~
@147=~"Je dois partir. Adieu."~
@149=~"Va pas dans le salon privé de Joseph, patron."~
@151=~"Je vois. J'ai une autre question..."~
@152=~"Je dois partir. Adieu."~
@154=~"Un portail vers les Enfers ? Y en a pas dans l'Bas-Quartier ? C'est pas pour ça qu'il s'appelle comme ça ?"~
@156=~"Je vois. J'ai une autre question..."~
@157=~"Je dois partir. Adieu."~
@159=~"Le lascar qui tient ce quartier dans son poing. Cherche pas les ennuis avec lui, patron."~
@161=~"Je vois. J'ai une autre question..."~
@162=~"Je dois partir. Adieu."~
@164=~Adrean montre le grand escalier de la rue."Il crèche près du marché, là-haut, mais ça fait un moment qu'j'l'ai pas vu. Tu ferais mieux d'demander à sa donzelle, Mare."~
@166=~"Très bien, où puis-je la trouver ?"~
@167=~"Je dois partir. Adieu."~
@169=~"Elle rôde souvent près d'la Mer Verticale. C'est une... dame d'la nuit, si tu vois c'que j'veux dire."~
@171=~"Où se trouve la Mer Verticale ?"~
@172=~"Je vois. J'ai une autre question..."~
@173=~"Je dois partir. Adieu."~
@175=~"C'est plus haut dans l'quartier, loin de l'eau, après la statue d'Athéna."~
@177=~"Je vois. J'ai une autre question..."~
@178=~"Je dois partir. Adieu."~
@180=~"Une partie d'la ville s'est fait aspirer dans l'Fossé y a quelques années. Le sol a été déchiqueté par la ronce-rasoir, et cette ronce s'étend vers l'intérieur depuis quelque temps. Certains affranchis s'en pissent dessus."~
@182=~"Je vois. J'ai une autre question..."~
@183=~"Je dois partir. Adieu."~
@185=~"Une bande de démons. Ils rôdent dans l'coin à la recherche d'hommes-rats qui leur ont volé quelque chose. Mais les rats sont introuvables, alors les fiélons cherchent juste les ennuis."~
@187=~"Je vois. J'ai une autre question..."~
@188=~"Je dois partir. Adieu."~
