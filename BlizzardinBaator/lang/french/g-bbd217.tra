@0=~"Hé ! Vous allez à la plage aujourd'hui ? Seulement 30 cuivres."~
@2=~"Voilà 30 cuivres. Allons-y."~
@3=~"Vous pouvez plutôt m'emmener au Couteau dans la Rivière ?"~
@4=~"Je n'ai pas autant d'argent."~
@5=~"Pas aujourd'hui."~
@7=~"Hé ! Vous allez à la plage aujourd'hui ? Seule-"~
@8=~"Avertissement ! Avertissement ! Clé de portail détectée. Embarquement interrompu ; vérifiez l'INVENTAIRE. Clé vers..."Le petit modrone étrange vrombit frénétiquement."... LE NIRVANA MÉCANIQUE DE MÉCANUS."~ [MODRO02]
@9=~"Oh, désolé, camarade. Vous transportez de la contrebande. Le radeau passe sous l'Arche du marin, alors mon petit ami ici me protège des voyages non sollicités. À mon avis, c'est plus fiable que toutes ces capes-clés ou clés-capes. Vous devez avoir quelque chose qui ouvre l'un des portails sur notre trajet. Débarrassez-vous-en et nous pourrons voyager ensemble."~
@10=~L'homme désigne la rive."Si vous ne l'avez pas déjà louée, la cabane propose une consigne."~
@12=~"Je reviendrai, alors."~
@14=~Le batelier hausse les épaules et continue d'observer les vagues.~
