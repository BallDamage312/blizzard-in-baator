@0=~"Approchez ! Départ immédiat pour la plage du Fossé ! Réchauffez vos vieux os à l'endroit le plus chaud de toute la Ruche ! Seulement 10 pièces de cuivre pour un trajet sûr jusqu'au port !"~
@2=~"Voilà 10 pièces de cuivre. Allons-y."~
@3=~"Je n'ai pas autant d'argent."~
@4=~"C'est vraiment l'endroit le plus chaud de la Ruche ?"~
@5=~"Pas aujourd'hui."~
@7=~"Approchez ! Départ immédiat pour la plage du Fossé ! Réchauffez vos vieux os à l'endroit le plus chaud de toute la Ruche ! Seulement 10 pièces de cuivre pour un trajet sûr jusqu'au port !"~
@9=~"Sais-tu quelque chose sur un temple secret d'hommes-rats ? J'ai entendu dire que des gamins l'avaient découvert."~
@10=~"Voilà 10 pièces de cuivre. Allons-y."~
@11=~"Je n'ai pas autant d'argent."~
@12=~Attendre que le guide parte et le suivre à bonne distance.~
@13=~"Pas aujourd'hui."~
@15=~"Oui, oui. Un portail vers les plages chaudes et ensoleillées de l'Ély-sium, juste sous le sable. Le meilleur pour vos os."~
@17=~"Tu m'as convaincu. Voilà 10 pièces de cuivre. Allons-y."~
@18=~"Je n'ai pas autant d'argent..."~
@19=~Attendre que le guide parte et le suivre à bonne distance.~
@20=~"Pas aujourd'hui."~
@22=~L'enfant hausse les épaules et reprend ses appels à destination des autres passants.~
@25=~"C'est les garçons du Fossé qui aiment ce genre de trucs. Moi, j'suis d'*ici*. Cherche un trio qui aime jouer à la Guerre Sanglante... et faire des costumes."~
@27=~"Merci. Voilà 10 pièces de cuivre. Allons au port."~
@28=~"Merci. À plus tard."~
