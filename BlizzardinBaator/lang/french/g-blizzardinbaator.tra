// =========== //
//////////////////

@100000 = ~"Meurs !"~
@100001 = ~"Je vais te geler le cul !"~
@100002 = ~"Entre Haer'Dalis !"~
@100003 = ~"Le destin nous appelle tous."~
@100004 = ~"Voilà un rôle que je joue avec plaisir !"~
@100005 = ~"Ouais, le sang vital d'une cité. *petit rire* Il monte et descend pareil sur tous les Plans."~
@100006 = ~*Sifflement*~
@100007 = ~"Je danserai volontiers sur votre musique... si seulement vous apprenez à en jouer."~
@100008 = ~"Il fait si chaud. Pas vrai ?"~
@100009 = ~"Quel endroit formidable !"~
@100010 = ~"Ahh !"~
@100011 = ~"Tu ne connais rien à l'Art !"~
@100012 = ~"Maintenant, tu meurs."~
@100013 = ~"Finis-le !"~
@100014 = ~"Crève, avorton !"~
@100015 = ~"MON LOUP !!!"~
@100016 = ~"Obéis !"~
@100017 = ~"Euh. Bon, alors..."~
@100018 = ~"Joseph le Noir... Comment dire... Je suis venu confisquer... ton imp."~
@100019 = ~"Oui... je crois."~
@100020 = ~"Ah oui ?"~
@100021 = ~"Je ne crois pas."~
@100022 = ~"J'aaarrive tout de suiiite."~
@100023 = ~"D'aaaaccord..."~
@100024 = ~"La Salle du Rutterkin est ouuouverte !"~
@100025 = ~"Cocktail du Fossé, c'est çaaa ?"~
@100026 = ~*Coassement*~
@100027 = ~"Approchez ! Départ pour la plage du Fossé, tout de suite !"~
@100028 = ~"Venez réchauffer vos vieux os dans l'endroit le plus chaud de toute la Ruche !"~
@100029 = ~"Voyage vers le Fossé ! Seulement 10 cuivres !"~
@100030 = ~"Ooooh..."~
@100031 = ~"Apporte des courants heureux à notre peuple..."~
@100032 = ~"Apporte la mort à nos ennemis !"~
@100033 = ~"Coupe-coupe, oui-oui... Les entrailles font floc-floc !"~
@100034 = ~"Gloire à Istishia !"~
@100035 = ~"Gloire à Baluu !"~
@100036 = ~"Gloire à la Dame Morte !"~
@100037 = ~"Gloire à Sire Scar !"~
@100038 = ~*Hurlement*~
@100039 = ~"Sale lézard de bige !"~
@100040 = ~"Cette fois, t'es fini !"~
@100041 = ~"Dis-moi, abishaï, Tiamat était à court de teinture rouge ?"~
@100042 = ~"Grrr..."~
@100043 = ~"Tu sais même pas tricher correctement !"~
@100044 = ~"Sale cabot plein de puces ! Tu vas ravaler tes paroles !"~
@100045 = ~"Un jour, je chanterai"Ô flammes jubilatoires"sur ta tombe."~
@100046 = ~*Coup de coude, clin d'œil*~
@100047 = ~"Hé, matois, tu veux t'amuser ?"~
@100048 = ~"Parlons un peu, beau gosse..."~
@100049 = ~"Écoute bien, je ne répéterai pas..."~
@100050 = ~"Tu comprends ce que je veux dire ?"~
@100051 = ~"Le paradoxe de la flèche, je t'en ai déjà parlé..."~
@100052 = ~"Oh, attends, je crois que je comprends..."~
@100053 = ~"Je comprends pas vraiment, mon pote..."~
@100054 = ~"Bon..."~
@100055 = ~*Hic !*~
@100056 = ~"Besoin d'que'que chose, patron... ?"~
@100057 = ~"Patron ! Paaatrooon !"~
@100058 = ~"Le... le meilleur rabatteur de toute cette foutue fourmilière !"~
@100059 = ~"Patron, file-moi du jonc et j'te donne des indications !"~
@100060 = ~*Rôt !*~
@100061 = ~"C'est une acc... accusation très sérieuse !"~
@100062 = ~"Oh, Sonne."~
@100063 = ~"Tu m'aimes vraiment ?"~
@100064 = ~"Chérie, s'il te plaît, sois honnête avec moi."~
@100065 = ~"Tu ne m'aimes plus ?"~
@100066 = ~"Oh, Zack..."~
@100067 = ~"Tu sais bien que je t'aime vraiment."~
@100068 = ~"Pourquoi tu ne comprends pas ce que je veux dire ?"~
@100069 = ~"L'amour n'est pas ce que tu crois."~
@100070 = ~"Tu commandes quelque chose ? Ou peut-être qu'un peu de jeu t'intéresse ?"~
@100071 = ~"Une pinte !"~
@100072 = ~"Voilà ta pinte, bige !"~
@100073 = ~"Voilà, mon pote !"~
@100074 = ~"Une pinte bien fraîche pour toi !"~
@100075 = ~"Attention à la tête, une pinte arrive !"~
@100076 = ~"Une bière de froment !"~
@100077 = ~"Une Bière abyssale d'Avner !"~
@100078 = ~"Un Vin de sang baatezu !"~
@100079 = ~"Les résultats de la course de rats-crânes sont..."~
@100080 = ~"Hé, vous là-bas, pas de bagarre !"~
@100081 = ~"Pas de feu à l'intérieur ! Ici, c'est pas le Cadavre Fumant !"~
@100082 = ~"Des nouvelles de la Guerre Sanglante ?"~
@100083 = ~"Vases ! Où êtes-vous ?"~
@100084 = ~"Un... Deux..."~
@100085 = ~"Attends, c'est une seule vase ? Ou deux collées l'une à l'autre ?"~
@100086 = ~"Par Primus, qu'est-ce que c'est sale ici..."~
@100087 = ~"Cassie ? C'est toi ?"~
@100088 = ~"Grrraou !"~
@100089 = ~"Hum. Grrraou, j'ai dit."~
@100090 = ~"Ayez peur !"~
@100091 = ~*Marmonnement*~
@100092 = ~*Marmonne*~
@100093 = ~"Six... Sept... Merde, je me suis encore trompé..."~
@100094 = ~"Les pores... Foutus pores..."~
@100095 = ~"Non ! Non ! NON !!!"~
@100096 = ~"Meurs, disparais !"~
@100097 = ~"Tu ne me feras plus de mal !"~
@100098 = ~*Cri*~
@100099 = ~*Soupir*~
@100100 = ~*Profond soupir*~
@100101 = ~*Gloussement*~
@100102 = ~*Ricanement*~
@100103 = ~*Petit rire*~
@100104 = ~"Rats ! Venez à moi, petits rats !"~
@100105 = ~"Je vous tiens !"~
@100106 = ~"Non ! Ne fuyez pas !"~
@100107 = ~"De l'or !"~
@100108 = ~"De l'ooooor !"~
@100109 = ~"Pas d'or... ?"~
@100110 = ~"Ils regardent !"~
@100111 = ~"Ils me voient !"~
@100112 = ~"Je sens votre regard ! Je ne le vois pas, mais je le sens !"~
@100113 = ~"Des yeux... Je vois des yeux ! Dans mon esprit !"~
@100114 = ~*Ploc*~
@100115 = ~"L'illumination est si proche..."~
@100116 = ~"Il était une fois un ivrogne de la Ruche..."~
@100117 = ~"Qu'est-ce qui pourrait venir ensuite... ?"~
@100118 = ~"Ruche... Qu'est-ce qui rime avec Ruche... ?"~
@100119 = ~"Ça fait seulement sept syllabes, ça ?"~
@100120 = ~"Bon, ça pourrait sonner bien..."~
@100121 = ~*Hum hum*~
@100122 = ~"Bon, on recommence..."~
@100123 = ~"Euh, excusez-moi ?"~
@100124 = ~"Vous avez vu une fille en robe rouge ?"~
@100125 = ~"Me regardez pas comme ça..."~
@100126 = ~"Une pinte !"~
@100127 = ~"Voilà votre pinte !"~
@100128 = ~"Tu commandes quelque chose, bipède ?"~
@100129 = ~"Voilà !"~
@100130 = ~"Une pinte bien fraîche pour toi !"~
@100131 = ~"Attention à la tête, une pinte arrive !"~
@100132 = ~"Qui a commandé la bière aux graines de tournesol ?"~
@100133 = ~"Une bière de maïs !"~
@100134 = ~"Quelle est la chanson ? Bois et raconte-moi."~
@100135 = ~"Maudits hommes-poissons ! Ils ont encore attaqué nos camarades ?"~
@100136 = ~"L'espion des Nations Mortes ? Liquidé, j'en ai peur."~
@100137 = ~"Regardez-moi ce sang rusé."~
@100138 = ~"C'est quoi, l'histoire de ce squelette ? J'espère que ce barbe-grise vient pas de chez Hargrimm."~
@100139 = ~"Attendez un instant, j'arrive."~
@100140 = ~"Ça fait très mal ?"~
@100141 = ~"Alors, ça va mieux, non ?"~
@100142 = ~"Doucement ! Je vais m'en occuper."~
@100143 = ~"Douleur, va-t'en !"~
@100144 = ~"Qui suis-je... ?"~
@100145 = ~"Hé, vous ! Vous me connaissez, par hasard ?"~
@100146 = ~"Qui est-ce que j'ai été pendant tout ce temps ?"~
@100147 = ~"Je suis juste un... tieffelin ? Ça, j'en suis sûr..."~
@100148 = ~"On est à Sigil, non ? Ouais, ça aussi je m'en souviens..."~
@100149 = ~"Monsieur ! Un peu de jonc !"~
@100150 = ~"Il me faut des pierres..."~
@100151 = ~"Vous avez des pierres ?"~
@100152 = ~"Il m'en faut tellement plus..."~
@100153 = ~"Regardez les couleurs !"~
@100154 = ~"Maman !"~
@100155 = ~*Cri*~
@100156 = ~"Des bipèdes dans le temple !"~
@100157 = ~"Le sang va couler !"~
@100158 = ~"Squerrik ! Accepte ces trésors et ce sacrifice sanglant pour ta gloire !"~
@100159 = ~"Tuez tous les bipèdes !"~
@100160 = ~"Cher monsieur ! Puisque vous êtes déjà là, une petite signature avant le saut ne vous coûterait rien."~
@100161 = ~"Une petite signature, un petit bond, et un avenir doré vous attend au pays des anges !"~
@100162 = ~"Monsieur ! Vous avez pris votre décision ?"~
@100163 = ~"Je comprends, je comprends. C'est une décision difficile. Mais si vous vous décidez, je serai là à vous attendre."~
@100164 = ~"Pas bon. Les Marqués viennent renifler par ici..."~
@100165 = ~"Patron, j'ai peur qu'on ait pas le temps de répéter au théâtre. Il faut se préparer à une bataille."~
@100166 = ~"Ouaf !"~
@100167 = ~"Aouuu !"~
@100168 = ~"Des nouvelles de Sigil ?"~
@100169 = ~"Mangez à votre faim ! Demain, on se bat encore !"~
@100170 = ~"Passe-moi du sanglier."~
@100171 = ~"Marqués ! Marqués ! Qui a raison ? Le plus fort !"~
@100172 = ~"Préparez le bain et le sauna, j'y vais bientôt."~
@100173 = ~"Heill Óðinn ! Sæl Óðinn !"~
@100174 = ~*Slurp*~
@100175 = ~*Schlorp*~
@100176 = ~*VROUM VROUM*~
@100177 = ~"J'ai hâte d'être à la bataille de demain."~
@100178 = ~"Quel festin !"~
@100179 = ~"La force fait le droit !"~
@100180 = ~"La force ! La force ! La force !"~
@100181 = ~"Heill Óðinn !"~
@100182 = ~"Tu veux marchander ?"~
@100183 = ~"Je me fiche de qui tu es. Le commerce donne un sens à tout, matois."~
@100184 = ~La caisse semble scellée par magie. Une clé est gravée près de la poignée, mais les détails ont disparu à cause des dégâts causés par l'eau.~
@100185 = ~Grâce au souvenir du dessin vu dans le livre-mimique, la caisse est désormais ouverte.~
@100186 = ~"APPROCHEZ, GOÛTEZ NOS CHOUX AU CRABE ! DES BOUCHÉES FUNKY QUI VOUS FERONT PLANER !"~
@100187 = ~"CHOUX AU CRABE, CHOUX AU CRABE, DÉLICE GLUANT ! REMETTEZ VOS CHOIX EN QUESTION À CHAQUE BOUCHÉE !"~
@100188 = ~"UN PETIT CREUX ? VOUS VOUS CROYEZ COSTAUD ? DÉFIEZ VOS PAPILLES, PRENEZ DES CHOUX AU CRABE !"~
@100189 = ~"CHOUX AU CRABE ICI, SOYEZ PAS TIMIDE ! VOUS LE REGRETTEREZ PEUT-ÊTRE... MAIS AU MOINS VOUS AUREZ ESSAYÉ !"~
@100190 = ~*Ouf*~
@100191 = ~"Et puis les chèvres flottantes sont arrivées."~
@100192 = ~*CLAP CLAP*~
@100193 = ~"Est-ce que je reste moi-même dans mes rêves ?"~
@100194 = ~"Comment distinguer une flamme d'une étincelle ?"~
@100195 = ~"Intéressant..."~
@100196 = ~^0xffFFFFFFJournal mis à jour^-~
@100197 = ~"LA MORT !"~
@100198 = ~"Les infidèles seront punis. Par LA MORT !"~
@100199 = ~"Þetta var frábardagi."~
@100200 = ~"Ég held að ég hafi drepið að minnsta kosti tólf."~
@100201 = ~"Það var nánast eins og á fornum dögum."~
@100202 = ~"Það er leitt með fallna menn."~
@100203 = ~"Gaaaah !"~
@100204 = ~"Aïe, aïe, aïe !!!"~
@100205 = ~"Maaamaaan !!!"~
@100206 = ~"À l'aaaiiide !!!"~
@100207 = ~"Hiiiiii !!!"~
@100208 = ~^0xffFFFFFFJournal mis à jour^-~
@100209 = ~"Ça doit être quelque part par ici..."~
@100210 = ~"C'était à cet étage ?"~
@100211 = ~"Ma cité a besoin de moi !"~
@100212 = ~"Peut-être que je pourrais..."~
@100213 = ~"Magnifique..."~
@100214 = ~*Renifle, renifle*~
@100215 = ~"Des roses, des roses !"~
@100216 = ~"Achetez vos fleurs !"~
@100217 = ~"Des gouttes de pluie sur les roses !"~
@100218 = ~"Des moustaches de chatons !"~
@100219 = ~"Des chats, de jolis chats."~
@100220 = ~"Vous avez toujours rêvé d'un ami qui pourrait vous manger ?"~
@100221 = ~"De brillantes bouilloires en cuivre !"~
@100222 = ~"Équipez votre cuisine chez moi !"~
@100223 = ~"Casseroles et bouilloires !"~
@100224 = ~"De chaudes moufles en laine !"~
@100225 = ~"Des chemises légères et amples."~
@100226 = ~"Des vêtements pour tous les temps !"~
@100227 = ~"Des paquets en papier brun !"~
@100228 = ~"Des boîtes ! Seulement chez moi !"~
@100229 = ~"Tout ce qui est en papier !"~
@100230 = ~"*FICELLEEE !*"~
@100231 = ~"Presque prêt à prendre le large, derniers sièges disponibles !"~
@100232 = ~"Faites comme un marin et embarquez sur mon radeau !"~
@100233 = ~"Ruche-Fossé, Fossé-Ruche, toute la journée, tous les jours !"~
@100234 = ~"Vous retournez au Cadavre Fumant ?"~
@100235 = ~"Hé ! Par ici ! Je vous conduis au centre de la Ruche."~
@100236 = ~"Bonjour, bonjour !"~
@100237 = ~Les deux moitiés du Crâne de jade s'attirent instantanément et se reforment en une seule dans un éclair d'énergie verte.~
@100238 = ~"Puissant Istishia, accepte ce sacrifice afin que ton océan de sang s'étende à jamais. Oui-oui !"~
@100239 = ~"Non ! Pitié ! Je vous en supplie !"~
@100240 = ~"Bloup, bloupidi, bloup-bloup. Coupe-coupe."~
@100241 = ~"GLOIRE, GLOIRE À ISTISHIA !"~
@100242 = ~"Alors, qu'est-ce qu'on fait maintenant ?"~
@100243 = ~"Je sais ! Faufilons-nous dans la Prison !"~
@100244 = ~"Et si on volait une clé à Artus ?"~
@100245 = ~"Je m'ennuie."~
@100246 = ~"Je me demande ce qu'il y a de l'autre côté du bord..."~
@100247 = ~"Ouaaah !"~
@100248 = ~*Renifle*~
@100249 = ~"Hiiiiiiiaaaah !"~
@100250 = ~^0x008000"M'sieur, arrêtez. Y a quelque chose qui va pas... Prod va..."^-~
@100251 = ~"Hé ! C'est le type qui a tué le patron. Animateur, ramène-toi !"~
@100253 = ~"Ce théâtre n'est-il pas magnifique ?"~
@100256 = ~"Je n'ai rien contre la comédie, mais les plaisanteries doivent avoir un but."~
@100257 = ~"Non, je ne crois pas que briser le quatrième mur soit justifié ici."~
@100258 = ~"D'accord, ça, c'est plutôt intéressant..."~
@100262 = ~"On répète encore une fois ?"~
@100263 = ~"Encore."~
@100264 = ~"J'espère que Kirinaldo va mieux."~
@100265 = ~"Où est cette doublure ? Il est encore en retard."~
@100266 = ~"La troupe de Sigil mérite votre attention et votre jonc. Je vous le garantis !"~
@100267 = ~"Si nous jouons bien, la tournée sur le Primaire se financera toute seule."~

