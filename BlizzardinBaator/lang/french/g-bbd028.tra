@0=~Vous approchez d'un demi-orque affairé à marteler une enclume difforme. En vous voyant arriver, il pose son marteau."Salut, toi ! T'as l'air nouveau en ville."~
@2=~"Qui es-tu ?"~
@3=~"J'ai quelques questions."~
@4=~"Je dois partir."~
@6=~Le demi-orque vous dévisage, surpris de vous revoir."Revoilà l'étranger."~
@8=~"Tu peux me montrer tes marchandises ?"~
@9=~"Tu as toujours besoin qu'on corrige ce voleur ?"~
@10=~"Tu peux me rappeler où trouver le voleur ?"~
@11=~"Ce voyou ne t'embêtera plus."~
@12=~"Qui es-tu, déjà ?"~
@13=~"J'ai quelques questions."~
@14=~"Je dois partir."~
@16=~Il crache dans son seau."Moi, c'est Adam ! J'suis l'forgeron du coin."~
@18=~"Tu peux me montrer tes marchandises ?"~
@19=~"J'ai quelques questions."~
@20=~"Je dois partir."~
@22=~"Demande toujours. P't-être que j'saurai répondre."~
@24=~"Tu peux me montrer tes marchandises ?"~
@25=~"Que peux-tu me dire sur cet endroit ?"~
@26=~"Tu vas parfois à la taverne de Rivergate ? Il y a là-bas un portail qui me pose problème."~
@27=~"Tu vas parfois à la taverne de Rivergate ? Il y a là-bas un portail qui me pose problème."~
@28=~"Tu sais quelque chose sur les récentes disparitions ?"~
@29=~"Le marchand de ficelle m'a dit que tu avais vendu beaucoup de ferraille à une prêtresse. Que peux-tu me dire sur elle ?"~
@30=~"La ronce-rasoir qui pousse juste à côté ne t'inquiète pas ?"~
@31=~"Il y a du travail dans le coin ?"~
@32=~"Tu connais un gith du nom d'Ikss'odes ? Il paraît qu'il vit dans le coin."~
@33=~"Je dois partir."~
@35=~"Des biges disparaissent dans l'coin. D'habitude, on les r'trouve dans l'Fossé avec une dague dans l'dos."~
@36=~Adam regarde nerveusement autour de lui."Mais les derniers ? Ils disparaissent, pouf... avec une odeur d'poiscaille."~
@38=~"Tu sais où ils disparaissent ?"~
@39=~"J'ai d'autres questions."~
@40=~"Je dois partir."~
@42=~Le demi-orque regarde à droite puis revient vers vous."Nan, pas vraiment..."~
@44=~"Tu es sûr ? Tu as hésité. J'ai l'impression que tu ne me dis pas tout, Adam."~
@45=~"J'ai d'autres questions."~
@46=~"Je dois partir."~
@48=~À contrecœur, il se penche par-dessus son enclume pour se rapprocher et baisse la voix."Tout a commencé quand les hommes-poissons ont débarqué dans l'quartier, tu vois, les faiseurs d'dieux ?"~
@49=~"Oh génial, chef. J'déteste ces petits saligauds. Leur foi est comme... de la foi en *plus fort*."~
@51=~"Tu veux dire les kuo-toas ? Je les ai vus dans le coin."~
@52=~"Tu veux dire les kuo-toas ?"~
@53=~"Les hommes-poissons ?"~
@54=~"J'ai d'autres questions."~
@55=~"Je dois partir."~
@57=~"Ouais, les hommes-poissons. J'sais même pas comment ça s'appelle, mais j'veux pas d'eux près d'moi, tu vois ?"~
@59=~"J'ai d'autres questions."~
@60=~"Je dois partir."~
@62=~"Ouais, justement. J'cherche quelqu'un pour refaire le portrait à un arnaqueur. Il arrête pas d'piquer ma bouffe et les Têtes de bois font rien. J'paierai du bon jonc."~
@64=~"Bien sûr, je peux casser quelques boîtes crâniennes pour toi."~
@65=~"Je ne veux pas m'en mêler. J'ai d'autres questions."~
@66=~"Désolé, non. Je dois partir."~
@68=~"Tu l'trouveras près d'la statue d'Athéna. La grande, vers la Mer Verticale. Il s'en prend aux visiteurs qui viennent prier là."~
@70=~"Oh, je me suis déjà débarrassé de cet homme."~
@71=~"Entendu. Je reviendrai vite. Mais j'ai encore quelques questions."~
@72=~"Ça marche. Je dois partir maintenant."~
@74=~"Ouais, bien sûr. Tu l'trouveras près d'la statue d'Athéna. Il s'en prend aux visiteurs qui viennent prier là."~
@76=~"Entendu. Je reviendrai vite. Mais j'ai encore quelques questions."~
@77=~"Ça marche. Je dois partir maintenant."~
@78=~"Désolé, non. Je dois partir."~
@80=~"Ah ! Alors il va enfin arrêter d'm'emmerder ? Beau boulot, matois, beau boulot. Tiens, ta récompense."~
@82=~"Merci ! J'ai quelques questions."~
@84=~Il se gratte le flanc musculeux, regarde autour de lui et hausse les épaules."C'est l'marché. Les gens viennent acheter des trucs. C'est l'coin l'moins cher d'la ville."~
@85=~"Si j'pouvais gagner assez pour dégager d'ce trou à merde, j'le ferais sans réfléchir."~
@87=~"J'ai d'autres questions."~
@88=~"Je dois partir."~
@90=~"Ça roule, les affaires, lascar."~
@93=~"Ouais. Brill garde les clés dans ses poches... enfin, les négatifs. Sale affaire capricieuse. Va lui causer d'ça."~
@95=~"J'ai d'autres questions."~
@96=~"Je dois partir."~
@98=~"C'est un trou à merde, bige. J'y vais pas."~
@100=~"J'ai d'autres questions."~
@101=~"Je dois partir."~
@103=~Adam montre la tente médicale."Il crèche au milieu d'ce coin. Mais ça fait un moment que j'l'ai pas vu. Tu ferais mieux d'demander à sa donzelle, Mare."~
@105=~"Très bien, où puis-je la trouver ?"~
@107=~"Elle traîne souvent près d'la Mer Verticale. C'est une... créature d'la nuit, si tu vois c'que j'veux dire."~
@109=~"Où se trouve la Mer Verticale ?"~
@110=~"Je vois. J'ai une autre question..."~
@111=~"Je dois partir. Adieu."~
@113=~"Bof, j'l'ai déjà vue pousser tellement d'fois. Et puis dans c'te ville, l'ciel peut nous tomber sur la tête n'importe quand."~
@115=~"Je comprends. J'ai une autre question..."~
@116=~"Je dois partir. Adieu."~
@118=~"Y a un portail derrière la statue de cette foutue cinglée, Athéna."~
@120=~"Je vois. J'ai une autre question..."~
@121=~"Je dois partir. Adieu."~
@123=~"Ouais, y en avait une comme ça. Elle achetait tout c'qui rouille pas dès qu'elle pouvait mettre la main dessus, comme si elle comptait vivre sous l'eau. P't-être qu'elle voulait s'installer dans une baraque inondée du coin. Elle était un peu bizarre, quand même..."~
@125=~"Je vois. J'ai une autre question..."~
@126=~"Je dois partir. Adieu."~
