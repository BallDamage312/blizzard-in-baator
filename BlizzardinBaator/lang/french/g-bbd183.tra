@0=~"Servez-vous. Ici, la nourriture et la boisson ne manquent jamais ! À Ulf ! Skål !"~
@2=~Festoyer avec eux.~
@3=~"Laissez tomber, adieu."~
@5=~"Bienvenue au Recouvrement des Dettes ! Parlez à Ulfbrand si vous voulez en savoir davantage sur nous."~
@8=~"Oh, une nouvelle tête ! Très bien, très bien ! Parlez à Ulfbrand, c'est le membre le plus haut placé de la faction ici."~
@11=~"Du sang neuf ? Pourquoi ça m'intéresserait ? J'ai pas le temps pour vous. Allez plutôt parler à Ulfbrand."~
@14=~"Hmm ? Oh, je vous avais pas vu. Parlez à Ulfbrand si vous voulez nous rejoindre."~
@17=~"Où est ce foutu registre ? Hmm... Oh ! Vous l'avez trouvé ? Non ? Alors me dérangez pas. Allez parler à Ulfbrand."~
@20=~"Vous êtes de la faction ? Je vous ai jamais vu ici. Ulfbrand voudra certainement vous parler."~
@23=~"Ah, bonjour, bonjour ! Encore un Marqué ? Ulfbrand sera ravi !"~
@26=~"J'ai dit de partir... Oh, pardon, je vous ai pris pour quelqu'un d'autre. Bref, je suis occupé. Vous feriez mieux de parler à Ulfbrand."~
@29=~"On n'aura jamais trop de Marqués ! Bientôt, nous serons la plus grande faction de Sigil ! Parlez à Ulfbrand si vous voulez nous aider à atteindre la grandeur !"~
@32=~"Mhm, mhm, oui, oui, si j'ajoute cinq ici et que je divise par trois... Hein ? Oh, vous cherchez sûrement Ulfbrand. Il est là-bas, au fond de la salle."~
@35=~"Ce doit être le destin qui vous a conduit chez les Marqués, haha ! Ulfbrand sera ravi !"~
@38=~"Hmm ? Ah, Ulfbrand a dit que de nouveaux membres pourraient se présenter ici. Parlez-lui, il vous expliquera tout."~
@41=~"Première fois en Ysgard ? Ça se voit. Sans vouloir vous offenser. Mieux vaut parler à Ulfbrand, il vous expliquera tout."~
@44=~"Ah, vivement ma prochaine séance de sauna... Quoi ? Ulfbrand ? Oui, il est ici, allez lui parler."~
@47=~"Me distrayez pas, j'ai une mission importante confiée par Ulfbrand. Si vous en voulez une aussi, allez lui parler."~
@50=~"Servez-vous. Ici, la nourriture et la boisson ne manquent jamais ! À Ulf ! Skål !"~
@52=~Festoyer avec eux.~
@53=~"Laissez tomber, adieu."~
@55=~"Servez-vous. Ici, la nourriture et la boisson ne manquent jamais ! À Ulf ! Skål !"~
@57=~Festoyer avec eux.~
@58=~"Laissez tomber, adieu."~
@60=~"Servez-vous. Ici, la nourriture et la boisson ne manquent jamais ! À Ulf ! Skål !"~
@62=~Festoyer avec eux.~
@63=~"Laissez tomber, adieu."~
@65=~"Servez-vous. Ici, la nourriture et la boisson ne manquent jamais ! À Ulf ! Skål !"~
@67=~Festoyer avec eux.~
@68=~"Laissez tomber, adieu."~
@70=~Sans Ulfbrand, les Marqués s'agitent sans véritable direction. Ils attendent manifestement qu'un nouveau chef prenne les choses en main.~
@72=~Partir.~
