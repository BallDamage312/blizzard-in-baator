@0=~Le corps de l'homme-rat femelle est entièrement gelé, sa bouche prisonnière de la glace implacable qui s'est formée dessus. Les mots viennent malgré tout, faibles et lointains."Où suis-je ?"~
@2=~"Tu es morte. Tu as été aspirée dans la huitième strate des Enfers. Tu t'es éloignée assez loin du portail ; tu devais être coriace."~
@3=~"Tu as volé la boucle d'oreille d'Ulfbrand ? Impressionnant, mais tu en as finalement payé le prix dans ces profondeurs gelées."~
@4=~"Tu avais la flûte du marraénoloth sur toi. Comment l'as-tu obtenue ?"~
@5=~"Repose maintenant, Ratilda."~
@7=~"J'étais... la plus coriace... de tous... pauvres petits mâles-rats... J'étais la perfection de l'homme-rat."~
@9=~"Tu es morte. Tu as été aspirée dans la huitième strate des Enfers. Tu t'es éloignée assez loin du portail ; tu devais être coriace."~
