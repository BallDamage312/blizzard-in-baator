@0=~Widzisz przed sobą wychudzonego człowieka, który kuli się na ziemi, kryjąc twarz w dłoniach. Cały się trzęsie. Nie dziwi cię to specjalnie, bo brudne szmaty, które ma na sobie, nie zapewniają zbyt wiele ciepła. Gdy podchodzisz bliżej, słyszysz, jak człowiek - mężczyzna, sądząc po głosie - mamrocze do siebie żałośnie, bujając się w przód i w tył: "Te oczy, ciągle się na mnie patrzą, ciągle się patrzą, zawsze tam są. Czuję je. One wiedzą, że ja wiem, wiedzą, że patrzyłem. Te oczy, te oczy..."~
@2=~"O czym ty mówisz?"~
@3=~"Nie mam czasu dla bzików."~
@4=~Odejdź.~
@6=~Mężczyzna mamrocze do siebie żałośnie, bujając się w przód i w tył. Twarz ma ukrytą w dłoniach. "Te oczy, ciągle się na mnie patrzą, ciągle się patrzą, zawsze tam są. Czuję je. One wiedzą, że ja wiem, wiedzą, że patrzyłem. Te oczy, te oczy..."~
@8=~"Może mógłbym dać ci jakieś oczy..."~
@9=~"O czym ty mówisz?"~
@10=~"Nie mam czasu dla bzików."~
@11=~Odejdź.~
@13=~Słysząc twój głos, mężczyzna wzdryga się. Powoli obraca głowę w twoją stronę i odsłania twarz. Wygląda młodo, chociaż cierpienie zdążyło już wyżłobić na jego skórze głębokie bruzdy. Uwagę najmocniej przyciągają jednak jego oczy - a raczej dwie puste, straszące ciemnością jamy oczodołów. Wokół nich pełno jest blizn i niezaleczonych jeszcze ranek, które przypominają drobne ślady zębów i pazurów. "Te oczy!" Wrzeszczy niby potępieniec cierpiący katusze w Sferach Niższych. "Oczy!"~
@15=~"Może mógłbym dać ci jakieś oczy. W końcu nikomu jeszcze nie zaszkodziła taka operacja na dworze."~
@16=~"Nie wiem, co ci się przytrafiło, ale współczuję ci. Mam nadzieję, że uda ci się znaleźć ukojenie. Żegnaj."~
@17=~"Tak, te oczy. Lepiej na nie uważaj. Żegnaj."~
@18=~Odejdź.~
@20=~Które oko chcesz oddać Iseyowi?~
@22=~Daj mu swoją gałkę oczną. Tę, którą masz w ekwipunku.~
@23=~Daj mu oko filozofa.~
@24=~Daj mu oko biesa.~
@25=~Daj mu szklane oko.~
@26=~Daj mu szklane oko.~
@27=~Daj mu bezkształtne oko.~
@28=~Daj mu kalejdoskopowe oko.~
@29=~Daj mu czarcie oko znalezione u Raveli.~
@30=~Daj mu oko Vekny, jeśli jesteś pewien, że to dobry pomysł.~
@31=~"Żartowałem. Bez oczu dużo bardziej ci do twarzy."~
@32=~"Chyba jednak nie mam oczu, które mogę oddać. Naprawdę bardzo chciałem, musisz mi wybaczyć."~
@33=~"Chyba nie mam więcej oczu, które mogę oddać. Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@35=~Mężczyzna mamrocze do siebie żałośnie, bujając się w przód i w tył: "Te oczy, te oczy..."~
@37=~Odejdź.~
@39=~Karmiłeś nadzieją pozbawionego oczu człowieka. Jego nietknięte gruczoły łzowe pod skórą tuż poniżej brwi właśnie zaczęły działać. Mężczyzna mamrocze do siebie żałośnie, bujając się w przód i w tył: "Te oczy, te oczy..."~
@41=~Odejdź.~
@43=~Próbujesz wstawić protezę oka filozofa do oczodołu. Nie patrzy się na to przyjemnie, ale w końcu gałka oczna *zaskakuje*. Pacjent krzyczy. "Widzę... Widzę wzory... rzeczywistości..." ~ [INT_12L1]
@45=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@46=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@47=~"Gratulacje, znowu masz oboje oczu!"~
@49=~Wstawiasz oko biesa do oczodołu. Pacjent krzyczy. Będzie miał szczęście, jeśli nie zabije go infekcja. "Tak boli... I czuję taki gniew...!" ~ [INT_12L1]
@51=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@52=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@53=~"Gratulacje, znowu masz oboje oczu!"~
@55=~Próbujesz wstawić szklaną protezę oka do oczodołu. Nie patrzy się na to przyjemnie, ale w końcu gałka oczna *zaskakuje*. Pacjent wydaje z siebie krzyk i powoli rozchyla powieki. Po chwili jednak sięga palcami do oczodołu, wyciąga protezę i oddaje ci ją z powrotem. ~ [INT_12L1]
@56=~"To oko nie działa!"~
@58=~"Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@60=~Próbujesz wstawić szklaną protezę oka do oczodołu. Nie patrzy się na to przyjemnie, ale w końcu gałka oczna *zaskakuje*. Wiesz, że proteza nie poprawi możliwości wzrokowych pacjenta, ale posiadanie znów obojga oczu może sprawić, że poczuje się on pewniej. ~ [INT_12L1]
@62=~"Gratulacje, znowu masz oboje oczu!"~
@64=~Próbujesz wstawić bezkształtną protezę oka do oczodołu. Nie patrzy się na to przyjemnie, ale w końcu gałka oczna *zaskakuje*. Pacjent krzyczy. ~ [INT_12L1]
@66=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@67=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@68=~"Gratulacje, znowu masz oboje oczu!"~
@70=~Próbujesz wstawić kalejdoskopową protezę do oczodołu. Mieni się wszystkimi barwami tęczy. W końcu *zaskakuje*. O dziwo, nie boli to pacjenta tak bardzo. Magiczne oko wrasta w oczodół. Jego niesamowita natura z pewnością przyczyniła się do zmniejszenia cierpienia podczas zabiegu. ~ [INT_12L1]
@72=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@73=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@74=~"Gratulacje, znowu masz oboje oczu!"~
@76=~Wstawiasz czarcie oko do oczodołu. Pacjent krzyczy. Będzie miał szczęście, jeśli nie zabije go infekcja. Oko wrasta w oczodół. "Dlaczego... myślę... o nadchodzących okazjach...? W takiej... chwili...?!" ~ [INT_12L1]
@78=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@79=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@80=~"Gratulacje, znowu masz oboje oczu!"~
@82=~Wstawiasz oko legendarnego lisza Vekny do oczodołu tego nieznanego nikomu biedaka. Podczas zabiegu Isey krzyczy z bólu, ale wręcz widzisz, jak błyskawicznie wracają mu siły. "Czuję taką... moc! Taką potęgę!" ~ [INT_12L1]
@84=~"Hm, jedno z głowy, ale przydałoby się i drugie... Zobaczę, czy mam jeszcze jakąś gałkę oczną na zbyciu."~
@85=~"Jedno oko musi ci wystarczyć. Otwórz powieki. I zobacz świat."~
@86=~"Gratulacje, znowu masz oboje oczu!"~
@88=~Mężczyzna powoli rozchyla powieki. Spogląda jednym okiem na otoczenie. "Ja... widzę. I... nikt mnie nie obserwuje...? Nie wiem, jak ci dziękować..." Nagle czujesz w dłoni jakiś przedmiot. Nie jesteś pewien, jak się tam znalazł.~
@90=~"Nie ma za co. Idź w świat i zobacz jego piękno."~
@91=~"Zapłata w miedziakach byłaby mile widziana."~
@92=~"Jesteś pewien? Nawet ja dostrzegam, jak się w ciebie wpatrują."~
@94=~Mężczyzna powoli rozchyla powieki. Spogląda obojgiem oczu na otoczenie. "Ja... widzę. I to na oboje oczu! I... nikt mnie nie obserwuje...? Nie wiem, jak ci dziękować..." Nagle czujesz w dłoni jakiś przedmiot. Nie jesteś pewien, jak się tam znalazł.~
@96=~"Nie ma za co. Idź w świat i zobacz jego piękno."~
@97=~"Zapłata w miedziakach byłaby mile widziana."~
@98=~"Jesteś pewien? Nawet ja dostrzegam, jak się w ciebie wpatrują."~
@100=~"Panie, ale ja nic nie mam! Jestem biedakiem! Nawet nie wiem, gdzie dokładnie jestem!"~
@102=~"Zapomnij. Idź już."~
@103=~"Jaka szkoda. Takie oczy nie są tanie. Będę musiał je zabrać z powrotem."~
@104=~"Co gorsza, oni ciągle patrzą."~
@106=~"Nie...! Nie! Oooooczyyyy..." Mężczyzna panikuje i potykając się, zaczyna odchodzić w przypadkowym kierunku.~
@108=~Odejdź zadowolony z siebie.~
@109=~Odejdź zadowolony z siebie.~
@111=~Nie-Sława podchodzi do mężczyzny i szepcze mu parę słów. Uspokaja go magią kapłańską i wskazuje mu kierunek, w którym mógłby się udać.~
@112=~"Takie okrucieństwo nie przystoi człowiekowi, którego kiedyś znałam. Nie wiem, co tobą kierowało, ale wiedz, że jestem bardzo zawiedziona."~
@113=~Mężczyzna nieporadnie próbuje podążać w wyznaczonym kierunku.~
@115=~"Przepraszam, sam nie wiem. Nie myślałem, co robię."~
@116=~"A nie było zabawnie? Dla mnie to było cholernie zabawne."~