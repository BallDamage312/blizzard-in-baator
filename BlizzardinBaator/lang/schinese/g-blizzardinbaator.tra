@100000 = ~“去死吧！”~
@100001 = ~“我要冻烂你的屁股！”~
@100002 = ~“海尔达利登场！”~
@100003 = ~“命运召唤我们所有人。”~
@100004 = ~“这个角色我很乐意扮演！”~
@100005 = ~“是啊，一座城市的命脉。*轻笑* 它在任何位面都同样潮起潮落。”~
@100006 = ~*吹口哨*~
@100007 = ~“我很乐意随你的调子起舞……只要你能学会演奏。”~
@100008 = ~“真暖和。是吧？”~
@100009 = ~“这地方真棒！”~
@100010 = ~“啊！”~
@100011 = ~“你对技艺一无所知！”~
@100012 = ~“现在，你去死吧。”~
@100013 = ~“了结它！”~
@100014 = ~“去死吧，你这小崽子！”~
@100015 = ~“我的狼！！！”~
@100016 = ~“听话！”~
@100017 = ~“呃。好吧，那么……”~
@100018 = ~“黑约瑟夫……我该怎么说呢……我是来没收……你的小魔鬼的。”~
@100019 = ~“是的……我想是这样。”~
@100020 = ~“是吗？”~
@100021 = ~“我可不这么想。”~
@100022 = ~“马上——就来——”~
@100023 = ~“好——吧——”~
@100024 = ~“污渠——鼠窝——来——了！”~
@100025 = ~“污渠鸡尾酒，对吧？”~
@100026 = ~*呱*~
@100027 = ~“都过来！马上出发去污渠海滩！”~
@100028 = ~“来全蜂巢最热的地方暖暖你们疲惫的老骨头吧！”~
@100029 = ~“去污渠一游！只要十个铜币！”~
@100030 = ~“哦……”~
@100031 = ~“为我们的同胞带来欢快的潮流……”~
@100032 = ~“为我们的敌人带去死亡！”~
@100033 = ~“快-快，是-是的……内脏要哗啦-哗啦响！”~
@100034 = ~“献给伊斯提悉亚的荣耀！”~
@100035 = ~“献给巴鲁的荣耀！”~
@100036 = ~“献给死亡女士的荣耀！”~
@100037 = ~“献给伤疤爵士的荣耀！”~
@100038 = ~*嚎叫*~
@100039 = ~“你这该死的蜥蜴！”~
@100040 = ~“这次，你完了！”~
@100041 = ~“告诉我，阿比沙魔，提亚马特在红色染料上吝啬了吗？”~
@100042 = ~“咕噜噜……”~
@100043 = ~“你连作弊都不会！”~
@100044 = ~“你这满身跳蚤的杂种狗！收回你的话！”~
@100045 = ~“总有一天，我会在你的坟墓上唱起‘哦，欢腾的火焰’。”~
@100046 = ~*轻推轻推，眨眼眨眼*~
@100047 = ~“嘿，家伙，想找点乐子吗？”~
@100048 = ~“聊聊吧，帅哥……”~
@100049 = ~“仔细听，我不会重复……”~
@100050 = ~“你明白我的意思吗？”~
@100051 = ~“飞矢悖论，我之前跟你说过……”~
@100052 = ~“哦等等，我想我懂了……”~
@100053 = ~“我真没搞懂，伙计……”~
@100054 = ~“对……”~
@100055 = ~*呃！*~
@100056 = ~“需……需要点什么，老大……？”~
@100057 = ~“老大！老——大！”~
@100058 = ~“这……这该死的大蚁丘里最好的向导！”~
@100059 = ~“老大，给我钱，我就给你指路！”~
@100060 = ~*打嗝！*~
@100061 = ~“这是……这是严重的指控！”~
@100062 = ~“哦，索恩。”~
@100063 = ~“你真的爱我吗？”~
@100064 = ~“亲爱的，请对我说实话。”~
@100065 = ~“你不再爱我了吗？”~
@100066 = ~“哦，扎克……”~
@100067 = ~“你知道我真的爱你。”~
@100068 = ~“你为什么不明白我的意思？”~
@100069 = ~“爱不是你想的那样。”~
@100070 = ~“您是点东西，还是想赌两把？”~
@100071 = ~“品脱酒来了！”~
@100072 = ~“您的品脱酒，呆瓜！”~
@100073 = ~“给您，伙计！”~
@100074 = ~“给您一杯鲜啤！”~
@100075 = ~“小心头，酒来了！”~
@100076 = ~“小麦啤酒来了！”~
@100077 = ~“阿夫纳深渊啤酒来了！”~
@100078 = ~“巴特祖血酒来了！”~
@100079 = ~“颅鼠赛马的结果是……”~
@100080 = ~“那边那个，不许打架！”~
@100081 = ~“室内禁止明火！这儿可不是‘冒烟尸骸’！”~
@100082 = ~“血战有什么新消息吗？”~
@100083 = ~“软泥怪！你们在哪儿？”~
@100084 = ~“一……二……”~
@100085 = ~“等等，那是一只软泥怪，还是两只紧挨在一起？”~
@100086 = ~“以奇点之名，这儿真脏……”~
@100087 = ~“卡西？是你吗？”~
@100088 = ~“吼！”~
@100089 = ~“咳咳。我说，吼。”~
@100090 = ~“害怕吧！”~
@100091 = ~*嘀咕*~
@100092 = ~*嘟囔*~
@100093 = ~“六……七……该死，我又搞错了……”~
@100094 = ~“毛孔……该死的毛孔……”~
@100095 = ~“不！不！不！！！”~
@100096 = ~“死吧，灭亡吧！”~
@100097 = ~“你再也伤不了我了！”~
@100098 = ~*尖叫*~
@100099 = ~*叹气*~
@100100 = ~*沉重的叹息*~
@100101 = ~*咯咯笑*~
@100102 = ~*窃笑*~
@100103 = ~*暗笑*~
@100104 = ~“老鼠！到我这儿来，小老鼠们！”~
@100105 = ~“抓到你了！”~
@100106 = ~“不！别跑！”~
@100107 = ~“金子！”~
@100108 = ~“金——子！”~
@100109 = ~“没有金子……？”~
@100110 = ~“他们在看着！”~
@100111 = ~“他们看得见我！”~
@100112 = ~“我感觉到你的凝视！我看不见，但我能感觉到！”~
@100113 = ~“眼睛……我看见眼睛了！在我脑海里！”~
@100114 = ~*滴*~
@100115 = ~“启迪近在咫尺……”~
@100116 = ~“从前有个来自蜂巢的酒鬼……”~
@100117 = ~“下一句该是什么……？”~
@100118 = ~“蜂巢……什么词和蜂巢押韵……？”~
@100119 = ~“这有七个音节吗？”~
@100120 = ~“好吧，这听起来不错……”~
@100121 = ~*咳咳*~
@100122 = ~“好吧，我们重新开始……”~
@100123 = ~“嗯，打扰一下？”~
@100124 = ~“你见过一个穿红裙子的女孩吗？”~
@100125 = ~“别那样看着我……”~
@100126 = ~“品脱酒来了！”~
@100127 = ~“您的品脱酒！”~
@100128 = ~“您要点什么，两足动物？”~
@100129 = ~“给您！”~
@100130 = ~“给您一杯鲜啤！”~
@100131 = ~“小心头，酒来了！”~
@100132 = ~“谁点了葵花籽啤酒？”~
@100133 = ~“玉米啤酒来了！”~
@100134 = ~“有什么消息？喝完了告诉我。”~
@100135 = ~“该死的鱼人！他们又袭击我们的同志了？”~
@100136 = ~“死者国度的间谍？恐怕是被勒死了。”~
@100137 = ~“看看那个精明的家伙。”~
@100138 = ~“那骷髅到底是怎么回事？我希望这个灰胡子不是从哈格里姆来的。”~
@100139 = ~“稍等片刻，我到你那儿去。”~
@100140 = ~“很疼吗？”~
@100141 = ~“现在，感觉好点了吧？”~
@100142 = ~“别急！我来处理。”~
@100143 = ~“疼痛，走开！”~
@100144 = ~“我是谁……？”~
@100145 = ~“嘿，你！你碰巧认识我吗？”~
@100146 = ~“这整段时间里我到底是谁？”~
@100147 = ~“我只是个……提夫林？这个我很确定……”~
@100148 = ~“这是印记城，对吧？是的，这是我记得的另一件事……”~
@100149 = ~“先生！施舍点钱吧！”~
@100150 = ~“我需要石头……”~
@100151 = ~“你有石头吗？”~
@100152 = ~“我还需要更多……”~
@100153 = ~“看那些颜色！”~
@100154 = ~“妈妈！”~
@100155 = ~*尖叫*~
@100156 = ~“神庙里有两足动物！”~
@100157 = ~“会流血的！”~
@100158 = ~“斯奎瑞克！接受这些财宝和血祭，以彰显你的荣耀！”~
@100159 = ~“杀死所有两足动物！”~
@100160 = ~“亲爱的先生！既然您已经来了，跳下去之前不妨把这个签了。”~
@100161 = ~“签个字，然后一跃而起，天使之地就有金色的未来等着您！”~
@100162 = ~“先生！您决定了吗？”~
@100163 = ~“我明白，我明白。这是个艰难的决定。但如果您决定要做了，我会在这儿等着。”~
@100164 = ~“不妙。争取者一直在这一带嗅来嗅去……”~
@100165 = ~“老大，恐怕没时间排练戏剧了。我们得准备战斗了。”~
@100166 = ~“汪！”~
@100167 = ~“嗷呜！”~
@100168 = ~“印记城有什么消息吗？”~
@100169 = ~“吃饱喝足！明天再战！”~
@100170 = ~“递给我些野猪肉。”~
@100171 = ~“定命会！定命会！什么是对的？强权就是对的！”~
@100172 = ~“准备洗澡水和桑拿，我马上过去。”~
@100173 = ~“Heill Óðinn! Sæl Óðinn!”~
@100174 = ~*咕嘟*~
@100175 = ~*咕噜*~
@100176 = ~*WURR TURR*~
@100177 = ~“我等不及明天的战斗了。”~
@100178 = ~“真是盛宴！”~
@100179 = ~“强权即公理！”~
@100180 = ~“力量！力量！力量！”~
@100181 = ~“Heill Óðinn!”~
@100182 = ~“想交易吗？”~
@100183 = ~“我不在乎你是谁。交易就是一切的意义，家伙。”~
@100184 = ~板条箱似乎被魔法封印了。把手旁边刻着一把钥匙，但细节因水浸而模糊不清。~
@100185 = ~凭借对书形变形怪身上图画的记忆，板条箱现在打开了。~
@100186 = ~“走过路过别错过，今天尝尝蟹泡芙！神奇小点心，让你爽翻天！”~
@100187 = ~“蟹泡芙，蟹泡芙，软糯的喜悦！每一口都让你怀疑人生！”~
@100188 = ~“肚子饿了吗？觉得自己很强？挑战你的味蕾，来点蟹泡芙！”~
@100189 = ~“蟹泡芙在这儿，别害羞！你可能会后悔……但至少你试过了！”~
@100190 = ~*呼*~
@100191 = ~“然后漂浮山羊来了。”~
@100192 = ~*啪啪*~
@100193 = ~“在梦中，我还是我自己吗？”~
@100194 = ~“我怎么能分辨火焰与火星的区别？”~
@100195 = ~“有意思……”~
@100196 = ~^0xffFFFFFF日志更新^-~
@100197 = ~“死亡！”~
@100198 = ~“不忠者将受到惩罚。处以死亡！”~
@100199 = ~“Þetta var frábardagi.”~
@100200 = ~“Ég held að ég hafi drepið að minnsta kosti tólf.”~
@100201 = ~“Það var nánast eins og á fornum dögum.”~
@100202 = ~“Það er leitt með fallna menn.”~
@100203 = ~“啊啊啊！”~
@100204 = ~“哎哟，哎哟，哎哟！！！”~
@100205 = ~“妈——妈！！！”~
@100206 = ~“救——命！！！”~
@100207 = ~“咿——！！！”~
@100208 = ~^0xffFFFFFF日志更新^-~
@100209 = ~“肯定在这附近的什么地方……”~
@100210 = ~“是在这一层吗？”~
@100211 = ~“我的城市需要我！”~
@100212 = ~“也许我可以……”~
@100213 = ~“真美……”~
@100214 = ~*吸吸*~
@100215 = ~“玫瑰，玫瑰！”~
@100216 = ~“买花咯！”~
@100217 = ~“玫瑰上的雨滴！”~
@100218 = ~“小猫的胡须！”~
@100219 = ~“猫咪，可爱的猫咪。”~
@100220 = ~“想要一个会吃掉你的朋友吗？”~
@100221 = ~“明亮的铜水壶！”~
@100222 = ~“用我填满你的厨房！”~
@100223 = ~“锅和水壶！”~
@100224 = ~“温暖的羊毛手套！”~
@100225 = ~“凉爽的宽松衬衫。”~
@100226 = ~“适合各种天气的衣服！”~
@100227 = ~“棕色纸包装！”~
@100228 = ~“箱子！只有我有！”~
@100229 = ~“所有纸制品！”~
@100230 = ~“*绳——子！*”~
@100231 = ~“快准备好起航了，最后几个座位！”~
@100232 = ~“像个水手一样行动，来做我的木筏！”~
@100233 = ~“污渠-蜂巢，蜂巢-污渠，全天候，每一天！”~
@100234 = ~“你要回‘冒烟尸骸’吗？”~
@100235 = ~“嘿！这边！我带你去蜂巢中心。”~
@100236 = ~“你好，你好！”~
@100237 = ~玉骷髅的两半瞬间被吸在一起，在一道绿色能量的闪光中重新合为一体。~
@100238 = ~“伟大的伊斯提悉亚，接受这祭品，让你的血海永远蔓延。是-是的！”~
@100239 = ~“不！求你了！我恳求你！”~
@100240 = ~“噗噜，噗噜噜，噗噜-嘟噗。快-快。”~
@100241 = ~“荣耀，荣耀归于伊斯提悉亚！”~
@100242 = ~“那么，我们接下来做什么？”~
@100243 = ~“我知道！我们偷偷溜进监狱！”~
@100244 = ~“我们去偷阿图斯的钥匙怎么样？”~
@100245 = ~“我好无聊。”~
@100246 = ~“我想知道边缘那边是什么……”~
@100247 = ~“哇啊啊啊！”~
@100248 = ~*吸鼻子*~
@100249 = ~“咦咦咦咦呀！”~
@100250 = ~^0x008000“先生，停下。不对劲……普罗德会……”^-~
@100251 = ~“喂！就是那个杀了老大的家伙。动画师，快过来这里！”~
@100253 = ~“这剧院是不是很华丽？”~
@100256 = ~“我不反对喜剧，但笑话应该有目的。”~
@100257 = ~“不，我认为在这里打破第四面墙是不合理的。”~
@100258 = ~“好吧，那确实挺有意思的……”~
@100262 = ~“我们再排练一遍那个？”~
@100263 = ~“再来。”~
@100264 = ~“我希望科里纳多感觉好点了。”~
@100265 = ~“那个替身哪儿去了？他又迟到了。”~
@100266 = ~“印记城剧团值得您的关注和金钱。我保证！”~
@100267 = ~“如果我们表演得好，主物质位面的巡演就能自筹资金了。”~

